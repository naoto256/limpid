{
  "name": "limpid-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port=8088 --output=.dev",
    "build": "eleventy",
    "preview": "node preview.mjs",
    "check": "node --test test/*.test.mjs",
    "check:links": "node test/links.mjs",
    "format:check": "prettier --check lib src test preview.mjs eleventy.config.js package.json README.md ../.github/workflows/site.yml"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.1",
    "prettier": "3.6.2"
  }
}
