// Summary:     Palo Alto Networks PAN-OS native CSV syslog → LSIS,
//              dispatched by the positional Type field.
// Reads:       ingress (raw wire) — syslog-wrapped positional CSV
//              (FUTURE_USE,RecvTime,Serial,Type,Subtype,...)
//              workspace.paloalto_syslog.timezone (optional, String) — source
//              timezone override as an IANA name or fixed offset; legacy
//              Receive/Generated Time defaults to UTC when absent
//              (PAN-OS defines Receive/Generated Time meanings but gives a
//              zone only for the separate high-resolution timestamp)
//              https://docs.paloaltonetworks.com/ngfw/administration/monitoring/use-syslog-for-monitoring/syslog-field-descriptions/traffic-log-fields
//              UTC is the intentional pack default; override this slot or use
//              a custom parser when the source zone is known to differ.
// Writes:      workspace.lsis.parsed.* — TRAFFIC → 4001, THREAT → 2004
//              (url → 6004, wildfire → 2004), GLOBALPROTECT /
//              AUTHENTICATION → 3002; paloalto_syslog_to_otlp writes
//              source-owned OTLP Resource, Body, and LogRecord attributes.
// Category:    Network firewall / IPS
// Test corpus: synthetic (documentation-derived sample wires in this header)
//
// Wire —    syslog-wrapped CSV — `<priority>timestamp host FUTURE_USE,RecvTime,Serial,Type,Subtype,...`
//          PAN-OS native CSV log format (positional, ~60-117 fields per
//          Type; Next-Generation Firewalls — PA-series, VM-series).
//          The outer syslog priority is transport metadata. Of the
//          supported standard-format bodies, only THREAT carries the
//          independent source `Severity` field (position 35).
//
// PAN-OS encodes the log Type at position 4 in the CSV row —
//   "TRAFFIC"        — connection start/end (OCSF Network Activity 4001)
//   "THREAT"         — IPS / vulnerability / spyware / virus
//                      (OCSF Detection Finding 2004; also URL via
//                       Subtype="url" → OCSF Web Resource Access 6004,
//                       and WILDFIRE via Subtype="wildfire" → 2004)
//   "GLOBALPROTECT"  — VPN session events (OCSF Authentication 3002)
//   "AUTHENTICATION" — admin / user authentication (OCSF Authentication 3002)
//   "SYSTEM"         — device events
//   "CONFIG"         — configuration changes
//   "USERID"         — user-ID mapping
//   "HIPMATCH"       — Host Information Profile match
//
// Two-pass parse —
//   1. Lightweight csv_parse with a header-only schema to extract
//      `Type` (and `Subtype` for THREAT routing) — keeps the dispatcher
//      cheap, single-row parse skips most of the field array.
//   2. The matched leaf re-runs csv_parse with the type-specific full
//      schema and maps to canonical workspace.lsis.parsed.
//
// Sample input (RFC 3164 syslog wrapper around CSV, TRAFFIC):
//   <134>Apr 27 10:00:00 fw-pan01 1,2026/04/27 10:00:00,012345678,TRAFFIC,end,2049,2026/04/27 10:00:00,192.0.2.10,198.51.100.5,...

// ---------------------------------------------------------------------------
// Vendor-specific mapping helpers (PAN-OS dialect)
// ---------------------------------------------------------------------------

// PAN-OS standard THREAT CSV `Severity` → OTel SeverityNumber. The
// documented wire domain is lowercase and is matched exactly.
def function paloalto_syslog_severity_number(sev) {
    switch sev {
        "informational" { 9 }
        "low"           { 13 }
        "medium"        { 17 }
        "high"          { 19 }
        "critical"      { 21 }
        null             { null }
        default          { null }
    }
}

def process parse_paloalto_syslog_normalize_threat_severity {
    let severity = switch workspace.pan.Severity {
        ""      { null }
        default { workspace.pan.Severity }
    }
    let severity_number = paloalto_syslog_severity_number(severity)
    switch true {
        severity != null and severity_number == null {
            error "parse_paloalto_syslog: invalid PAN-OS THREAT severity ${severity}"
        }
        default {
            workspace.paloalto_syslog_severity = {
                number: severity_number,
                text:   severity
            }
        }
    }
}

def process parse_paloalto_syslog_normalize_time {
    switch workspace.paloalto_syslog.timezone {
        "local" { error "parse_paloalto_syslog: source timezone must be an IANA name or fixed offset, not local" }
    }
    let source_timezone = coalesce(workspace.paloalto_syslog.timezone, "UTC")
    workspace.paloalto_syslog.time = switch true {
        workspace.pan.GenerateTime == null { null }
        workspace.pan.GenerateTime == ""   { null }
        default {
            to_int(strptime(
                workspace.pan.GenerateTime,
                "%Y/%m/%d %H:%M:%S",
                source_timezone
            ))
        }
    }
}

// PAN-OS TRAFFIC `Action` field. OCSF Network Activity (4001)
// activity_id values: 0 Unknown / 1 Open / 2 Close / 3 Reset /
// 4 Fail / 5 Refuse / 6 Traffic / 99 Other.
def function paloalto_syslog_traffic_action_to_activity_id(act) {
    switch act {
        "allow"        { 6 }
        "drop"         { 5 }
        "deny"         { 5 }
        "reset-both"   { 3 }
        "reset-server" { 3 }
        "reset-client" { 3 }
        default        { 0 }
    }
}

// PAN-OS THREAT/URL `Action` field → OCSF disposition_id.
def function paloalto_syslog_threat_disposition_id(act) {
    switch act {
        "alert"        { 6 }
        "allow"        { 1 }
        "block"        { 2 }
        "block-url"    { 2 }
        "block-ip"     { 2 }
        "drop"         { 5 }
        "deny"         { 2 }
        "reset-both"   { 2 }
        "reset-server" { 2 }
        "reset-client" { 2 }
        "default"      { 0 }
        "continue"     { 1 }
        "override"     { 1 }
        default        { 0 }
    }
}

// IANA proto name → number. PAN-OS emits the protocol name string.
include "../functions/proto_num.limpid"

// ---------------------------------------------------------------------------
// Dispatcher: parse syslog wrapper, extract Type+Subtype for routing
// ---------------------------------------------------------------------------
//
// The header schema names only the fields we need to dispatch:
// position 4 = Type, position 5 = Subtype. Everything before / after is
// ignored at this stage; the matched leaf re-parses the full row with
// its own schema.

def process parse_paloalto_syslog {
    workspace.syslog = syslog.parse(ingress)
    workspace.pan_header = csv_parse(workspace.syslog.msg, ["", "", "", "Type", "Subtype"])
    switch workspace.pan_header.Type {
        "TRAFFIC"        { process parse_paloalto_syslog_traffic }
        "THREAT"         { process parse_paloalto_syslog_threat }
        "GLOBALPROTECT"  { process parse_paloalto_syslog_globalprotect }
        "AUTHENTICATION" { process parse_paloalto_syslog_authentication }
        // SYSTEM / CONFIG / USERID / HIPMATCH follow when concrete
        // mappings stabilise.
        default { error "parse_paloalto_syslog: unsupported PAN-OS log Type: ${workspace.pan_header.Type}" }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: TRAFFIC → OCSF Network Activity (4001)
// ---------------------------------------------------------------------------
//
// PAN-OS TRAFFIC field schema (positions 1-49 cover the OCSF-relevant
// surface; later fields like SD-WAN / device profiles / Pod metadata
// are skipped via empty-name padding because they don't have a clean
// OCSF home in 1.3.0).
//
// Precondition (contract; not runtime-checked):
//   workspace.syslog.msg is the raw CSV row of a PAN-OS TRAFFIC log.
def process parse_paloalto_syslog_traffic {
    workspace.pan = csv_parse(workspace.syslog.msg, [
        "",                  // 1  FUTURE_USE
        "ReceiveTime",       // 2
        "Serial",            // 3
        "Type",              // 4
        "Subtype",           // 5  start / end / drop / deny
        "",                  // 6  FUTURE_USE / ConfigVersion
        "GenerateTime",      // 7
        "SourceAddress",     // 8
        "DestinationAddress",// 9
        "NATSourceIP",       // 10
        "NATDestinationIP",  // 11
        "RuleName",          // 12
        "SourceUser",        // 13
        "DestinationUser",   // 14
        "Application",       // 15
        "VirtualSystem",     // 16
        "SourceZone",        // 17
        "DestinationZone",   // 18
        "InboundInterface",  // 19
        "OutboundInterface", // 20
        "LogForwardingProfile", // 21
        "",                  // 22 FUTURE_USE
        "SessionID",         // 23
        "RepeatCount",       // 24
        "SourcePort",        // 25
        "DestinationPort",   // 26
        "NATSourcePort",     // 27
        "NATDestinationPort",// 28
        "Flags",             // 29
        "IPProtocol",        // 30
        "Action",            // 31
        "Bytes",             // 32
        "BytesSent",         // 33
        "BytesReceived",     // 34
        "Packets",           // 35
        "StartTime",         // 36
        "ElapsedTime",       // 37
        "Category",          // 38
        "",                  // 39 FUTURE_USE
        "SequenceNumber",    // 40
        "ActionFlags",       // 41
        "SourceLocation",    // 42
        "DestinationLocation",// 43
        "",                  // 44 FUTURE_USE
        "PacketsSent",       // 45
        "PacketsReceived",   // 46
        "SessionEndReason",  // 47
        "",                  // 48 DeviceGroupHierarchyL1
        "",                  // 49 DeviceGroupHierarchyL2
        "",                  // 50 DeviceGroupHierarchyL3
        "",                  // 51 DeviceGroupHierarchyL4
        "VirtualSystemName", // 52
        "DeviceName"         // 53
    ])
    process parse_paloalto_syslog_normalize_time
    workspace.lsis.parsed = {
        class_uid:    4001,
        category_uid: 4,
        activity_id:  paloalto_syslog_traffic_action_to_activity_id(workspace.pan.Action),
        time:         workspace.paloalto_syslog.time,
        src_endpoint: {
            ip:       workspace.pan.SourceAddress,
            port:     to_int(workspace.pan.SourcePort),
            location: { country: workspace.pan.SourceLocation }
        },
        dst_endpoint: {
            ip:       workspace.pan.DestinationAddress,
            port:     to_int(workspace.pan.DestinationPort),
            location: { country: workspace.pan.DestinationLocation }
        },
        connection_info: {
            protocol_num:  proto_num(workspace.pan.IPProtocol),
            protocol_name: lower(workspace.pan.IPProtocol)
        },
        traffic: {
            bytes_in:    to_int(workspace.pan.BytesReceived),
            bytes_out:   to_int(workspace.pan.BytesSent),
            packets_in:  to_int(workspace.pan.PacketsReceived),
            packets_out: to_int(workspace.pan.PacketsSent)
        },
        app_name: workspace.pan.Application,
        actor: {
            user: { name: workspace.pan.SourceUser }
        },
        session_uid: workspace.pan.SessionID,
        rule:        workspace.pan.RuleName,
        device:      { name: workspace.pan.DeviceName },
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: THREAT → routes by Subtype
// ---------------------------------------------------------------------------
//
// THREAT records share a base schema but the Subtype determines OCSF
// class:
//   "url"          → Web Resource Access (6004)
//   "wildfire"     → Detection Finding (2004), Malware
//   "wildfire-virus" → Detection Finding (2004), Malware
//   "virus"        → Detection Finding (2004), Malware
//   "vulnerability"/ "spyware" / "file" / "data" / "scan" / "flood"
//                  → Detection Finding (2004), generic
//
// We re-parse with the THREAT schema once, then route by Subtype.
def process parse_paloalto_syslog_threat {
    workspace.pan = csv_parse(workspace.syslog.msg, [
        "",                  // 1
        "ReceiveTime",       // 2
        "Serial",            // 3
        "Type",              // 4
        "Subtype",           // 5  url / vulnerability / virus / wildfire / etc.
        "",                  // 6
        "GenerateTime",      // 7
        "SourceAddress",     // 8
        "DestinationAddress",// 9
        "NATSourceIP",       // 10
        "NATDestinationIP",  // 11
        "RuleName",          // 12
        "SourceUser",        // 13
        "DestinationUser",   // 14
        "Application",       // 15
        "VirtualSystem",     // 16
        "SourceZone",        // 17
        "DestinationZone",   // 18
        "InboundInterface",  // 19
        "OutboundInterface", // 20
        "LogForwardingProfile", // 21
        "",                  // 22
        "SessionID",         // 23
        "RepeatCount",       // 24
        "SourcePort",        // 25
        "DestinationPort",   // 26
        "NATSourcePort",     // 27
        "NATDestinationPort",// 28
        "Flags",             // 29
        "IPProtocol",        // 30
        "Action",            // 31
        "URLFilename",       // 32  URL or filename for THREAT
        "ThreatName",        // 33  e.g. "SuperVirus.A" or signature name
        "Category",          // 34  URL category for url subtype
        "Severity",          // 35  informational/low/medium/high/critical
        "Direction",         // 36  client-to-server / server-to-client
        "SequenceNumber",    // 37
        "ActionFlags",       // 38
        "SourceLocation",    // 39
        "DestinationLocation",// 40
        "",                  // 41
        "ContentType",       // 42  HTTP content-type for URL subtype
        "PCAPID",            // 43
        "FileHash",          // 44  MD5/SHA256 for virus / wildfire
        "Cloud",              // 45
        "URLIndex",          // 46
        "UserAgent",         // 47
        "FileType",          // 48
        "XForwardedFor",     // 49
        "Referer",           // 50
        "Sender",            // 51
        "Subject",           // 52
        "Recipient",         // 53
        "ReportID",          // 54  WildFire report id
        "",                  // 55 DeviceGroupHierarchyL1
        "",                  // 56 DeviceGroupHierarchyL2
        "",                  // 57 DeviceGroupHierarchyL3
        "",                  // 58 DeviceGroupHierarchyL4
        "VirtualSystemName", // 59
        "DeviceName",        // 60
        "",                  // 61 FUTURE_USE
        "SourceVMUUID",      // 62
        "DestinationVMUUID"  // 63
    ])
    switch workspace.pan.Subtype {
        "url"            { process parse_paloalto_syslog_threat_url }
        "wildfire"       { process parse_paloalto_syslog_threat_wildfire }
        "wildfire-virus" { process parse_paloalto_syslog_threat_wildfire }
        "virus"          { process parse_paloalto_syslog_threat_virus }
        // vulnerability / spyware / file / data / scan / flood share
        // the generic detection mapping below.
        "vulnerability"  { process parse_paloalto_syslog_threat_generic }
        "spyware"        { process parse_paloalto_syslog_threat_generic }
        "file"           { process parse_paloalto_syslog_threat_generic }
        "data"           { process parse_paloalto_syslog_threat_generic }
        "scan"           { process parse_paloalto_syslog_threat_generic }
        "flood"          { process parse_paloalto_syslog_threat_generic }
        default { error "parse_paloalto_syslog: unsupported PAN-OS THREAT subtype: ${workspace.pan.Subtype}" }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: THREAT/url → OCSF Web Resource Access (6004)
// ---------------------------------------------------------------------------
def process parse_paloalto_syslog_threat_url {
    process parse_paloalto_syslog_normalize_threat_severity
    process parse_paloalto_syslog_normalize_time
    let activity = switch workspace.pan.Action {
        "block-url"    { 2 }
        "block"        { 2 }
        "deny"         { 2 }
        "drop"         { 2 }
        "reset-both"   { 2 }
        "reset-server" { 2 }
        "reset-client" { 2 }
        "alert"        { 1 }
        "allow"        { 1 }
        "continue"     { 1 }
        "override"     { 1 }
        default        { 0 }
    }
    workspace.lsis.parsed = {
        class_uid:       6004,
        category_uid:    6,
        activity_id:     activity,
        severity_number: workspace.paloalto_syslog_severity.number,
        severity:        workspace.paloalto_syslog_severity.text,
        time:            workspace.paloalto_syslog.time,
        src_endpoint: {
            ip:   workspace.pan.SourceAddress,
            port: to_int(workspace.pan.SourcePort)
        },
        dst_endpoint: {
            ip:   workspace.pan.DestinationAddress,
            port: to_int(workspace.pan.DestinationPort)
        },
        http_request: {
            url:        { url_string: workspace.pan.URLFilename },
            user_agent: workspace.pan.UserAgent,
            referrer:   workspace.pan.Referer
        },
        web_resources: [
            {
                url:      { url_string: workspace.pan.URLFilename },
                category: workspace.pan.Category
            }
        ],
        actor: {
            user: { name: workspace.pan.SourceUser }
        },
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: THREAT/wildfire → OCSF Detection Finding (2004) Malware
// ---------------------------------------------------------------------------
def process parse_paloalto_syslog_threat_wildfire {
    process parse_paloalto_syslog_normalize_threat_severity
    process parse_paloalto_syslog_normalize_time
    workspace.lsis.parsed = {
        class_uid:       2004,
        category_uid:    2,
        activity_id:     1,
        severity_number: workspace.paloalto_syslog_severity.number,
        severity:        workspace.paloalto_syslog_severity.text,
        time:            workspace.paloalto_syslog.time,
        disposition_id: paloalto_syslog_threat_disposition_id(workspace.pan.Action),
        finding_info: {
            title: workspace.pan.ThreatName,
            uid:   workspace.pan.ReportID,
            types: ["Malware"]
        },
        malware: [
            {
                name:               workspace.pan.ThreatName,
                classification_ids: [1]
            }
        ],
        evidences: [
            {
                file: {
                    name:   workspace.pan.URLFilename,
                    hashes: [{ value: workspace.pan.FileHash }]
                }
            }
        ],
        src_endpoint: {
            ip:   workspace.pan.SourceAddress,
            port: to_int(workspace.pan.SourcePort)
        },
        dst_endpoint: {
            ip:   workspace.pan.DestinationAddress,
            port: to_int(workspace.pan.DestinationPort)
        },
        actor: { user: { name: workspace.pan.SourceUser } },
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: THREAT/virus → OCSF Detection Finding (2004) Malware
// ---------------------------------------------------------------------------
def process parse_paloalto_syslog_threat_virus {
    process parse_paloalto_syslog_normalize_threat_severity
    process parse_paloalto_syslog_normalize_time
    workspace.lsis.parsed = {
        class_uid:       2004,
        category_uid:    2,
        activity_id:     1,
        severity_number: workspace.paloalto_syslog_severity.number,
        severity:        workspace.paloalto_syslog_severity.text,
        time:            workspace.paloalto_syslog.time,
        disposition_id: paloalto_syslog_threat_disposition_id(workspace.pan.Action),
        finding_info: {
            title: workspace.pan.ThreatName,
            types: ["Malware"]
        },
        malware: [
            {
                name:               workspace.pan.ThreatName,
                classification_ids: [1]
            }
        ],
        evidences: [
            {
                file: {
                    name:   workspace.pan.URLFilename,
                    hashes: [{ value: workspace.pan.FileHash }]
                }
            }
        ],
        src_endpoint: {
            ip:   workspace.pan.SourceAddress,
            port: to_int(workspace.pan.SourcePort)
        },
        dst_endpoint: {
            ip:   workspace.pan.DestinationAddress,
            port: to_int(workspace.pan.DestinationPort)
        },
        actor: { user: { name: workspace.pan.SourceUser } },
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: THREAT/{vulnerability,spyware,file,data,scan,flood}
//             → OCSF Detection Finding (2004) generic
// ---------------------------------------------------------------------------
def process parse_paloalto_syslog_threat_generic {
    process parse_paloalto_syslog_normalize_threat_severity
    process parse_paloalto_syslog_normalize_time
    workspace.lsis.parsed = {
        class_uid:       2004,
        category_uid:    2,
        activity_id:     1,
        severity_number: workspace.paloalto_syslog_severity.number,
        severity:        workspace.paloalto_syslog_severity.text,
        time:            workspace.paloalto_syslog.time,
        disposition_id: paloalto_syslog_threat_disposition_id(workspace.pan.Action),
        finding_info: {
            title: workspace.pan.ThreatName,
            types: [workspace.pan.Subtype]
        },
        attack: {
            technique: { name: workspace.pan.ThreatName }
        },
        src_endpoint: {
            ip:   workspace.pan.SourceAddress,
            port: to_int(workspace.pan.SourcePort)
        },
        dst_endpoint: {
            ip:   workspace.pan.DestinationAddress,
            port: to_int(workspace.pan.DestinationPort)
        },
        actor: { user: { name: workspace.pan.SourceUser } },
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: GLOBALPROTECT → OCSF Authentication (3002)
// ---------------------------------------------------------------------------
//
// GlobalProtect (VPN) sessions and authentication. PAN-OS 9.x+ uses a
// dedicated GLOBALPROTECT log type with Stage / EventID / Description
// fields rather than a generic THREAT-style schema.
def process parse_paloalto_syslog_globalprotect {
    workspace.pan = csv_parse(workspace.syslog.msg, [
        "",                 // 1
        "ReceiveTime",      // 2
        "Serial",           // 3
        "Type",             // 4
        "",                 // 5
        "",                 // 6
        "GenerateTime",     // 7
        "VirtualSystem",    // 8
        "EventID",          // 9   gateway-connected / portal-prelogin / etc.
        "Stage",            // 10  before-login / login / tunnel / disconnected
        "AuthMethod",       // 11
        "TunnelType",       // 12
        "SourceUser",       // 13
        "SourceRegion",     // 14
        "MachineName",      // 15
        "PublicIP",         // 16
        "PublicIPv6",       // 17
        "PrivateIP",        // 18
        "PrivateIPv6",      // 19
        "HostID",           // 20
        "SerialNumber",     // 21
        "ClientVersion",    // 22
        "ClientOS",         // 23
        "ClientOSVersion",  // 24
        "RepeatCount",      // 25
        "Reason",           // 26  failure reason / disconnect reason
        "ErrorCode",        // 27
        "Description"       // 28
    ])
    process parse_paloalto_syslog_normalize_time
    let activity = switch workspace.pan.Stage {
        "before-login"  { 1 }
        "login"         { 1 }
        "tunnel"        { 1 }
        "disconnected"  { 2 }
        default         { 0 }
    }
    let status = switch workspace.pan.EventID {
        "gateway-auth-failed"      { 2 }
        "portal-auth-failed"       { 2 }
        "gateway-connect-failed"   { 2 }
        "tunnel-establish-failed"  { 2 }
        default                    { 1 }
    }
    workspace.lsis.parsed = {
        class_uid:    3002,
        category_uid: 3,
        activity_id:  activity,
        status_id:    status,
        time:         workspace.paloalto_syslog.time,
        user: {
            name: workspace.pan.SourceUser
        },
        src_endpoint: {
            ip: workspace.pan.PublicIP
        },
        device: {
            name: workspace.pan.MachineName,
            uid:  workspace.pan.HostID,
            os:   {
                name:    workspace.pan.ClientOS,
                version: workspace.pan.ClientOSVersion
            }
        },
        message:  workspace.pan.Description,
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: AUTHENTICATION → OCSF Authentication (3002)
// ---------------------------------------------------------------------------
//
// Admin / captive portal / authentication-policy-match events.
def process parse_paloalto_syslog_authentication {
    workspace.pan = csv_parse(workspace.syslog.msg, [
        "",                  // 1
        "ReceiveTime",       // 2
        "Serial",            // 3
        "Type",              // 4
        "Subtype",           // 5  e.g. "auth-success" / "auth-fail"
        "",                  // 6
        "GenerateTime",      // 7
        "VirtualSystem",     // 8
        "SourceUser",        // 9
        "NormalizedUser",    // 10
        "ObjectName",        // 11
        "AuthenticationPolicy", // 12
        "RepeatCount",       // 13
        "AuthenticationID",  // 14
        "Vendor",            // 15  authentication server vendor
        "LogAction",         // 16
        "ServerProfile",     // 17
        "Description",       // 18
        "ClientType",        // 19
        "EventType",         // 20  success / failure
        "FactorNumber",      // 21
        "SequenceNumber",    // 22
        "ActionFlags",       // 23
        "",                  // 24
        "",                  // 25
        "",                  // 26
        "",                  // 27
        "VirtualSystemName", // 28
        "DeviceName",        // 29
        "SourceAddress"      // 30
    ])
    process parse_paloalto_syslog_normalize_time
    let status = switch workspace.pan.EventType {
        "success" { 1 }
        "failure" { 2 }
        default   { 0 }
    }
    workspace.lsis.parsed = {
        class_uid:    3002,
        category_uid: 3,
        activity_id:  1,
        status_id:    status,
        time:         workspace.paloalto_syslog.time,
        user: {
            name: workspace.pan.SourceUser
        },
        src_endpoint: { ip: workspace.pan.SourceAddress },
        message:      workspace.pan.Description,
        metadata: {
            product: {
                vendor_name: "Palo Alto Networks",
                name:        "PAN-OS"
            },
            version: "1.3.0"
        }
    }
}

def function paloalto_syslog_otlp_event_kind(class_uid) {
    switch class_uid {
        2004    { "alert" }
        default { "event" }
    }
}

def function paloalto_syslog_otlp_event_category(class_uid) {
    switch class_uid {
        2004    { "intrusion_detection" }
        3002    { "authentication" }
        6004    { "web" }
        default { "network" }
    }
}

def function paloalto_syslog_otlp_event_type(class_uid, activity_id) {
    switch class_uid {
        2004    { "indicator" }
        3002 {
            switch activity_id { 2 { "end" } default { "start" } }
        }
        6004    { "access" }
        default { "connection" }
    }
}

def function paloalto_syslog_otlp_event_outcome(status_id) {
    switch status_id {
        1       { "success" }
        2       { "failure" }
        default { null }
    }
}

def process paloalto_syslog_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Palo Alto Networks" } }],
        [{ key: "observer.product", value: { string_value: "PAN-OS" } }],
        [{ key: "observer.type", value: { string_value: "firewall" } }],
        switch workspace.pan.Serial != null and workspace.pan.Serial != "" {
            true { [{ key: "observer.serial_number", value: { string_value: workspace.pan.Serial } }] }
            default { [] }
        },
        switch workspace.pan.DeviceName != null and workspace.pan.DeviceName != "" {
            true { [{ key: "host.name", value: { string_value: workspace.pan.DeviceName } }] }
            default { [] }
        },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.log_record.body = { string_value: workspace.syslog.msg }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: paloalto_syslog_otlp_event_kind(workspace.lsis.parsed.class_uid) } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: paloalto_syslog_otlp_event_category(workspace.lsis.parsed.class_uid) }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: paloalto_syslog_otlp_event_type(workspace.lsis.parsed.class_uid, workspace.lsis.parsed.activity_id) }] } } }],
        switch coalesce(workspace.pan.EventID, workspace.pan.Subtype, workspace.pan.Type) != null {
            true { [{ key: "event.code", value: { string_value: coalesce(workspace.pan.EventID, workspace.pan.Subtype, workspace.pan.Type) } }] }
            default { [] }
        },
        switch workspace.pan.Action != null {
            true { [{ key: "event.action", value: { string_value: workspace.pan.Action } }] }
            default { [] }
        },
        switch paloalto_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) != null {
            true { [{ key: "event.outcome", value: { string_value: paloalto_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.message != null {
            true { [{ key: "message", value: { string_value: workspace.lsis.parsed.message } }] }
            default { [] }
        },
        switch coalesce(workspace.lsis.parsed.actor.user.name, workspace.lsis.parsed.user.name) != null {
            true { [{ key: "user.name", value: { string_value: coalesce(workspace.lsis.parsed.actor.user.name, workspace.lsis.parsed.user.name) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.ip != null {
            true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.port != null {
            true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] }
            default { [] }
        },
        switch workspace.pan.SourceZone != null and workspace.pan.SourceZone != "" {
            true { [{ key: "source.zone", value: { string_value: workspace.pan.SourceZone } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.ip != null {
            true { [{ key: "destination.ip", value: { string_value: workspace.lsis.parsed.dst_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.port != null {
            true { [{ key: "destination.port", value: { int_value: workspace.lsis.parsed.dst_endpoint.port } }] }
            default { [] }
        },
        switch workspace.pan.DestinationZone != null and workspace.pan.DestinationZone != "" {
            true { [{ key: "destination.zone", value: { string_value: workspace.pan.DestinationZone } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_name != null {
            true { [{ key: "network.transport", value: { string_value: workspace.lsis.parsed.connection_info.protocol_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_num != null {
            true { [{ key: "network.iana_number", value: { int_value: workspace.lsis.parsed.connection_info.protocol_num } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.app_name != null {
            true { [{ key: "network.application", value: { string_value: workspace.lsis.parsed.app_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.traffic.bytes_out != null {
            true { [{ key: "source.bytes", value: { int_value: workspace.lsis.parsed.traffic.bytes_out } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.traffic.bytes_in != null {
            true { [{ key: "destination.bytes", value: { int_value: workspace.lsis.parsed.traffic.bytes_in } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.session_uid != null {
            true { [{ key: "palo_alto.session.id", value: { string_value: workspace.lsis.parsed.session_uid } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.rule != null {
            true { [{ key: "rule.name", value: { string_value: workspace.lsis.parsed.rule } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.http_request.url.url_string != null {
            true { [{ key: "url.full", value: { string_value: workspace.lsis.parsed.http_request.url.url_string } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.http_request.user_agent != null {
            true { [{ key: "user_agent.original", value: { string_value: workspace.lsis.parsed.http_request.user_agent } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.http_request.referrer != null {
            true { [{ key: "http.request.referrer", value: { string_value: workspace.lsis.parsed.http_request.referrer } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.title != null {
            true { [{ key: "palo_alto.threat.name", value: { string_value: workspace.lsis.parsed.finding_info.title } }] }
            default { [] }
        },
        switch workspace.pan.FileHash != null and workspace.pan.FileHash != "" {
            true { [{ key: "palo_alto.file.hash", value: { string_value: workspace.pan.FileHash } }] }
            default { [] }
        }
    )
}
