// Summary:     Fortinet FortiGate native key=value syslog (FortiOS
//              "default" format) → same LSIS shape as parse_fortigate_cef.
// Reads:       ingress (raw wire) — syslog priority + KV body
//              (date=... time=... type=...)
// Writes:      workspace.lsis.parsed.* — same classes as parse_fortigate_cef
//              (the LSIS contract is format-agnostic).
//              fortigate_syslog_to_otlp additionally writes the
//              source-specific workspace.lsis.shed.otlp Resource, Body,
//              and LogRecord attributes consumed by compose_otlp.
// Category:    Network firewall / IPS
// Test corpus: synthetic (FortiOS "default"-format sample wires in this header)
//
// Wire —    syslog priority + KV body — `<priority>date=... time=... type=... ...`
//          FortiOS 6.x / 7.x native log "default" format (key=value
//          pairs), not CEF.
//
// Sample input (FortiOS "default" format — no RFC 3164 header between
// the <PRI> and the KV body; date/time/devname live inside the body):
//   <134>date=2026-04-27 time=10:00:00 devname="fw01" level="notice" type="traffic" subtype="forward" srcip=192.0.2.10 srcport=54321 dstip=198.51.100.5 dstport=443 proto=6 action="accept" sentbyte=1024 rcvdbyte=512
//
// Direct call (skip syslog wrapper, supply raw KV in `ingress`):
//   process { workspace.kv = parse_kv(ingress) } | parse_fortigate_syslog_traffic
//
// Why a separate file from parse_fortigate_cef.limpid:
//   FortiGate's native syslog and its CEF export are different schemas
//   (different field names: `srcip` vs `src`, `sentbyte` vs `in`,
//   `subtype` ext vs `subtype` field, etc.). Per the v0.6.0 plan,
//   schema = vendor × format, and FortiGate has two formats so it gets
//   two parser files.
//
// Vendor-specific def function helpers in this file have a `_syslog_`
// segment in their name so they can coexist with the `_cef_` versions
// in the same global function namespace if both files are included by
// the same config (a single FortiGate device emitting both formats is
// uncommon but valid).

// ---------------------------------------------------------------------------
// Vendor-specific mapping helpers (FortiGate native syslog dialect)
// ---------------------------------------------------------------------------

// FortiGate native syslog body `level` field is one of:
//   emergency / alert / critical / error / warning / notice / information / debug
// Map it to OTel SeverityNumber. The outer syslog PRI is transport metadata
// and is not consulted.
def function fortigate_syslog_severity_number(level) {
    switch level {
        "emergency"   { 21 }
        "alert"       { 19 }
        "critical"    { 18 }
        "error"       { 17 }
        "warning"     { 13 }
        "notice"      { 10 }
        "information" { 9 }
        "debug"       { 5 }
        default       { null }
    }
}

// Normalize and validate body severity at every public leaf boundary so
// direct leaf calls and dispatcher calls have the same contract.
def process normalize_fortigate_syslog_severity_number {
    workspace.fortigate_syslog.severity_number = fortigate_syslog_severity_number(workspace.kv.level)
    switch workspace.kv.level != null and workspace.fortigate_syslog.severity_number == null {
        true { error "parse_fortigate_syslog: invalid FortiOS native log level ${workspace.kv.level}" }
    }
}

// FortiGate traffic `action` → OCSF Network Activity activity_id.
// Same dialect as the CEF version but kept name-distinct so both files
// can coexist (Rule of Three: 2 instances acceptable; 3rd → extract).
def function fortigate_syslog_action_to_activity_id(act) {
    switch act {
        "accept"      { 6 }
        "start"       { 1 }
        "close"       { 2 }
        "client-rst"  { 3 }
        "server-rst"  { 3 }
        "timeout"     { 4 }
        "deny"        { 5 }
        "block"       { 5 }
        default       { 0 }
    }
}

// UTM `action` → OCSF Detection Finding disposition_id.
def function fortigate_syslog_utm_disposition_id(act) {
    switch act {
        "passthrough" { 1 }
        "allowed"     { 1 }
        "pass"        { 1 }
        "blocked"     { 2 }
        "block"       { 2 }
        "quarantined" { 3 }
        "modified"    { 4 }
        "dropped"     { 5 }
        "drop"        { 5 }
        "detected"    { 6 }
        "monitor"     { 6 }
        "monitored"   { 6 }
        "info"        { 6 }
        default       { 0 }
    }
}

// IANA proto number → name. Same table as the CEF version.
def function fortigate_syslog_proto_name(num) {
    switch num {
        1  { "icmp" }
        6  { "tcp" }
        17 { "udp" }
        47 { "gre" }
        50 { "esp" }
        58 { "icmpv6" }
        default { null }
    }
}

// ---------------------------------------------------------------------------
// Top-level dispatcher: strip <PRI>, parse KV body, dispatch on type:subtype
// ---------------------------------------------------------------------------
//
// FortiGate's "default" syslog format emits `<PRI>date=... time=... type=...`
// directly — there is no RFC 3164 timestamp/host header between the priority
// and the KV body. So we cannot use `syslog.parse(ingress)`; we strip just
// the leading `<PRI>` and feed the rest straight into `parse_kv`. The body
// itself carries `date` and `time` as KV fields, plus `devname` for host.
//
// Verified against real FortiGate v7.x captures.
//
// Dispatch is flat on `type:subtype` (synthesized) so there's only one
// switch site per format — mirrors the CEF parser shape (which dispatches
// on `cat`, the CEF field that already carries `type:subtype`).

def process parse_fortigate_syslog {
    workspace.kv = parse_kv(syslog.strip_pri(ingress))
    let cat = workspace.kv.type + ":" + workspace.kv.subtype
    switch cat {
        "traffic:forward"    { process parse_fortigate_syslog_traffic }
        "traffic:local"      { process parse_fortigate_syslog_traffic }
        "traffic:multicast"  { process parse_fortigate_syslog_traffic }
        "traffic:sniffer"    { process parse_fortigate_syslog_traffic }
        "traffic:other"      { process parse_fortigate_syslog_traffic }
        "utm:ips"            { process parse_fortigate_syslog_utm_ips }
        "utm:anomaly"        { process parse_fortigate_syslog_utm_ips }
        "utm:webfilter"      { process parse_fortigate_syslog_utm_webfilter }
        "utm:virus"          { process parse_fortigate_syslog_utm_antivirus }
        "utm:dlp"            { process parse_fortigate_syslog_utm_dlp }
        "utm:app-ctrl"       { process parse_fortigate_syslog_utm_appctrl }
        "utm:application"    { process parse_fortigate_syslog_utm_appctrl }
        "utm:dns"            { process parse_fortigate_syslog_utm_dns }
        "utm:emailfilter"    { process parse_fortigate_syslog_utm_emailfilter }
        "utm:waf"            { process parse_fortigate_syslog_utm_waf }
        "utm:ssl"            { process parse_fortigate_syslog_utm_ssl }
        "utm:voip"           { process parse_fortigate_syslog_utm_voip }
        "event:user"             { process parse_fortigate_syslog_event_user }
        "event:vpn"              { process parse_fortigate_syslog_event_vpn }
        "event:system"           { process parse_fortigate_syslog_event_system }
        "event:wireless"         { process parse_fortigate_syslog_event_wireless }
        "event:security-rating"  { process parse_fortigate_syslog_event_security_rating }
        default { error "parse_fortigate_syslog: unsupported FortiGate syslog type:subtype: ${cat}" }
    }
}

// ---------------------------------------------------------------------------
// Common metadata builder — used by every leaf below
// ---------------------------------------------------------------------------

// FortiGate native syslog only flows from FortiGate appliances, so
// vendor / product are constants. `version_hint` is the firmware
// version from the syslog body's `osname` field when populated; older
// firmware that doesn't emit `osname` falls back to null and the
// composer's null-handling decides whether to keep the key.
def function fortigate_syslog_metadata(version_hint) {
    {
        product: {
            vendor_name: "Fortinet",
            name:        "FortiGate",
            version:     version_hint
        },
        version: "1.3.0"
    }
}

// ---------------------------------------------------------------------------
// OTLP source adapter
// ---------------------------------------------------------------------------
//
// The adapter owns only source-specific placement and AnyValue construction.
// Canonical time and severity scalars remain in `workspace.lsis.parsed` and
// are read directly by compose_otlp unless a caller provides an exceptional
// shed override. FortiOS native logs do not carry an instrumentation-scope
// identity, so this adapter deliberately leaves all scope slots unset.

def function fortigate_syslog_otlp_event_kind(log_type, subtype) {
    switch log_type + ":" + subtype {
        "utm:ips"             { "alert" }
        "utm:anomaly"         { "alert" }
        "utm:virus"           { "alert" }
        "utm:dlp"             { "alert" }
        "utm:app-ctrl"        { "alert" }
        "utm:application"     { "alert" }
        "utm:waf"             { "alert" }
        "utm:ssl"             { "alert" }
        "event:security-rating" { "alert" }
        default               { "event" }
    }
}

def function fortigate_syslog_otlp_event_category(log_type, subtype) {
    switch log_type + ":" + subtype {
        "utm:ips"             { "intrusion_detection" }
        "utm:anomaly"         { "intrusion_detection" }
        "utm:webfilter"       { "web" }
        "utm:virus"           { "malware" }
        "utm:dlp"             { "file" }
        "utm:waf"             { "intrusion_detection" }
        "utm:ssl"             { "intrusion_detection" }
        "utm:emailfilter"     { "email" }
        "event:user"          { "authentication" }
        "event:vpn"           { "authentication" }
        "event:system"        { "configuration" }
        "event:security-rating" { "configuration" }
        default               { "network" }
    }
}

// ECS event.type is an array. Firewall connection records retain the
// connection classification alongside their source action disposition.
def function fortigate_syslog_otlp_event_types(log_type, action) {
    switch log_type {
        "traffic" {
            switch action {
                "accept"     { [{ string_value: "connection" }, { string_value: "allowed" }] }
                "deny"       { [{ string_value: "connection" }, { string_value: "denied" }] }
                "block"      { [{ string_value: "connection" }, { string_value: "denied" }] }
                "start"      { [{ string_value: "connection" }, { string_value: "start" }] }
                "close"      { [{ string_value: "connection" }, { string_value: "end" }] }
                "client-rst" { [{ string_value: "connection" }, { string_value: "end" }] }
                "server-rst" { [{ string_value: "connection" }, { string_value: "end" }] }
                "timeout"    { [{ string_value: "connection" }, { string_value: "end" }] }
                default      { [{ string_value: "connection" }] }
            }
        }
        default {
            switch action {
                "allowed"           { [{ string_value: "allowed" }] }
                "accept"            { [{ string_value: "allowed" }] }
                "pass"              { [{ string_value: "allowed" }] }
                "passthrough"       { [{ string_value: "allowed" }] }
                "permit"            { [{ string_value: "allowed" }] }
                "blocked"           { [{ string_value: "denied" }] }
                "block"             { [{ string_value: "denied" }] }
                "deny"              { [{ string_value: "denied" }] }
                "dropped"           { [{ string_value: "denied" }] }
                "drop"              { [{ string_value: "denied" }] }
                "quarantined"       { [{ string_value: "denied" }] }
                "login"             { [{ string_value: "start" }] }
                "logon"             { [{ string_value: "start" }] }
                "auth-logon"        { [{ string_value: "start" }] }
                "tunnel-up"         { [{ string_value: "start" }] }
                "client-connect"    { [{ string_value: "start" }] }
                "client-associate"  { [{ string_value: "start" }] }
                "logout"            { [{ string_value: "end" }] }
                "logoff"            { [{ string_value: "end" }] }
                "auth-logoff"       { [{ string_value: "end" }] }
                "tunnel-down"       { [{ string_value: "end" }] }
                "client-disconnect" { [{ string_value: "end" }] }
                default             { [{ string_value: "info" }] }
            }
        }
    }
}

def function fortigate_syslog_otlp_event_outcome(status_id) {
    switch status_id {
        1       { "success" }
        2       { "failure" }
        default { null }
    }
}

// ECS tls.version carries only the numeric version. Keep the original FortiOS
// spelling separately under fortinet.tls.version.
def function fortigate_syslog_otlp_tls_version(version_text) {
    switch version_text {
        "tls1"   { "1.0" }
        "tls1.0" { "1.0" }
        "tls1.1" { "1.1" }
        "tls1.2" { "1.2" }
        "tls1.3" { "1.3" }
        default  { null }
    }
}

def process fortigate_syslog_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Fortinet" } }],
        [{ key: "observer.product", value: { string_value: "FortiGate" } }],
        [{ key: "observer.type", value: { string_value: "firewall" } }],
        switch workspace.kv.devid != null {
            true { [{ key: "observer.serial_number", value: { string_value: workspace.kv.devid } }] }
            default { [] }
        },
        switch workspace.kv.osname != null {
            true { [{ key: "observer.version", value: { string_value: workspace.kv.osname } }] }
            default { [] }
        },
        switch workspace.kv.devname != null {
            true { [{ key: "host.name", value: { string_value: workspace.kv.devname } }] }
            default { [] }
        },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )

    workspace.lsis.shed.otlp.log_record.body = {
        string_value: syslog.strip_pri(ingress)
    }

    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: fortigate_syslog_otlp_event_kind(workspace.kv.type, workspace.kv.subtype) } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: fortigate_syslog_otlp_event_category(workspace.kv.type, workspace.kv.subtype) }] } } }],
        [{ key: "event.type", value: { array_value: { values: fortigate_syslog_otlp_event_types(workspace.kv.type, workspace.kv.action) } } }],
        switch workspace.kv.action != null {
            true { [{ key: "event.action", value: { string_value: workspace.kv.action } }] }
            default { [] }
        },
        switch fortigate_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) != null {
            true { [{ key: "event.outcome", value: { string_value: fortigate_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.message != null {
            true { [{ key: "message", value: { string_value: workspace.lsis.parsed.message } }] }
            default { [] }
        },
        switch workspace.kv.logdesc != null {
            true { [{ key: "event.reason", value: { string_value: workspace.kv.logdesc } }] }
            default { [] }
        },
        switch workspace.kv.srcip != null {
            true { [{ key: "source.ip", value: { string_value: workspace.kv.srcip } }] }
            default { [] }
        },
        switch coalesce(workspace.kv.srcport, workspace.kv.src_port) != null {
            true { [{ key: "source.port", value: { int_value: to_int(coalesce(workspace.kv.srcport, workspace.kv.src_port)) } }] }
            default { [] }
        },
        switch workspace.kv.srcmac != null {
            true { [{ key: "source.mac", value: { string_value: workspace.kv.srcmac } }] }
            default { [] }
        },
        switch workspace.kv.sentbyte != null {
            true { [{ key: "source.bytes", value: { int_value: to_int(workspace.kv.sentbyte) } }] }
            default { [] }
        },
        switch workspace.kv.dstip != null {
            true { [{ key: "destination.ip", value: { string_value: workspace.kv.dstip } }] }
            default { [] }
        },
        switch coalesce(workspace.kv.dstport, workspace.kv.dst_port) != null {
            true { [{ key: "destination.port", value: { int_value: to_int(coalesce(workspace.kv.dstport, workspace.kv.dst_port)) } }] }
            default { [] }
        },
        switch workspace.kv.apmac != null {
            true { [{ key: "destination.mac", value: { string_value: workspace.kv.apmac } }] }
            default { [] }
        },
        switch workspace.kv.rcvdbyte != null {
            true { [{ key: "destination.bytes", value: { int_value: to_int(workspace.kv.rcvdbyte) } }] }
            default { [] }
        },
        switch fortigate_syslog_proto_name(to_int(workspace.kv.proto)) != null {
            true { [{ key: "network.transport", value: { string_value: fortigate_syslog_proto_name(to_int(workspace.kv.proto)) } }] }
            default { [] }
        },
        switch workspace.kv.proto != null {
            true { [{ key: "network.iana_number", value: { int_value: to_int(workspace.kv.proto) } }] }
            default { [] }
        },
        switch workspace.kv.user != null {
            true { [{ key: "user.name", value: { string_value: workspace.kv.user } }] }
            default { [] }
        },
        switch workspace.kv.url != null {
            true { [{ key: "url.full", value: { string_value: workspace.kv.url } }] }
            default { [] }
        },
        switch workspace.kv.method != null {
            true { [{ key: "http.request.method", value: { string_value: workspace.kv.method } }] }
            default { [] }
        },
        switch workspace.kv.qname != null {
            true { [{ key: "dns.question.name", value: { string_value: workspace.kv.qname } }] }
            default { [] }
        },
        switch workspace.kv.qtype != null {
            true { [{ key: "dns.question.type", value: { string_value: workspace.kv.qtype } }] }
            default { [] }
        },
        switch workspace.kv.error != null {
            true { [{ key: "fortinet.dns.error", value: { string_value: workspace.kv.error } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "emailfilter" and workspace.kv.from != null {
            true { [{ key: "email.from.address", value: { array_value: { values: [{ string_value: workspace.kv.from }] } } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "emailfilter" and workspace.kv.to != null {
            true { [{ key: "email.to.address", value: { array_value: { values: [{ string_value: workspace.kv.to }] } } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "emailfilter" and workspace.kv.subject != null {
            true { [{ key: "email.subject", value: { string_value: workspace.kv.subject } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "emailfilter" and workspace.kv.msgid != null {
            true { [{ key: "email.message_id", value: { string_value: workspace.kv.msgid } }] }
            default { [] }
        },
        switch workspace.kv.filename != null {
            true { [{ key: "file.name", value: { string_value: workspace.kv.filename } }] }
            default { [] }
        },
        switch workspace.kv.filesize != null {
            true { [{ key: "file.size", value: { int_value: to_int(workspace.kv.filesize) } }] }
            default { [] }
        },
        switch workspace.kv.analyticscksum != null {
            true { [{ key: "file.hash.sha256", value: { string_value: workspace.kv.analyticscksum } }] }
            default { [] }
        },
        switch fortigate_syslog_otlp_tls_version(workspace.kv.tlsver) != null {
            true { [{ key: "tls.version", value: { string_value: fortigate_syslog_otlp_tls_version(workspace.kv.tlsver) } }] }
            default { [] }
        },
        switch workspace.kv.sni != null {
            true { [{ key: "tls.client.server_name", value: { string_value: workspace.kv.sni } }] }
            default { [] }
        },
        switch workspace.kv.hostname != null {
            true { [{ key: "destination.domain", value: { string_value: workspace.kv.hostname } }] }
            default { [] }
        },
        [{ key: "fortinet.log.type", value: { string_value: workspace.kv.type } }],
        [{ key: "fortinet.log.subtype", value: { string_value: workspace.kv.subtype } }],
        switch workspace.kv.attack != null {
            true { [{ key: "fortinet.attack.name", value: { string_value: workspace.kv.attack } }] }
            default { [] }
        },
        switch workspace.kv.attackid != null {
            true { [{ key: "fortinet.attack.id", value: { string_value: workspace.kv.attackid } }] }
            default { [] }
        },
        switch workspace.kv.catdesc != null {
            true { [{ key: "fortinet.web.category", value: { string_value: workspace.kv.catdesc } }] }
            default { [] }
        },
        switch workspace.kv.virus != null {
            true { [{ key: "fortinet.malware.name", value: { string_value: workspace.kv.virus } }] }
            default { [] }
        },
        switch workspace.kv.virusid != null {
            true { [{ key: "fortinet.malware.id", value: { string_value: workspace.kv.virusid } }] }
            default { [] }
        },
        switch workspace.kv.filtername != null {
            true { [{ key: "fortinet.dlp.filter.name", value: { string_value: workspace.kv.filtername } }] }
            default { [] }
        },
        switch workspace.kv.filteridx != null {
            true { [{ key: "fortinet.dlp.filter.id", value: { string_value: workspace.kv.filteridx } }] }
            default { [] }
        },
        switch workspace.kv.app != null {
            true { [{ key: "fortinet.application.name", value: { string_value: workspace.kv.app } }] }
            default { [] }
        },
        switch workspace.kv.appid != null {
            true { [{ key: "fortinet.application.id", value: { string_value: workspace.kv.appid } }] }
            default { [] }
        },
        switch workspace.kv.signature != null {
            true { [{ key: "fortinet.waf.signature.name", value: { string_value: workspace.kv.signature } }] }
            default { [] }
        },
        switch workspace.kv.signatureid != null {
            true { [{ key: "fortinet.waf.signature.id", value: { string_value: workspace.kv.signatureid } }] }
            default { [] }
        },
        switch workspace.kv.eventsubtype != null {
            true { [{ key: "fortinet.tls.event_subtype", value: { string_value: workspace.kv.eventsubtype } }] }
            default { [] }
        },
        switch workspace.kv.tlsver != null {
            true { [{ key: "fortinet.tls.version", value: { string_value: workspace.kv.tlsver } }] }
            default { [] }
        },
        switch workspace.kv.profile != null {
            true { [{ key: "fortinet.tls.profile", value: { string_value: workspace.kv.profile } }] }
            default { [] }
        },
        switch workspace.kv.voip_proto != null {
            true { [{ key: "fortinet.voip.protocol", value: { string_value: workspace.kv.voip_proto } }] }
            default { [] }
        },
        switch workspace.kv.kind != null {
            true { [{ key: "fortinet.voip.kind", value: { string_value: workspace.kv.kind } }] }
            default { [] }
        },
        switch workspace.kv.status != null {
            true { [{ key: "fortinet.voip.status", value: { string_value: workspace.kv.status } }] }
            default { [] }
        },
        switch workspace.kv.call_id != null {
            true { [{ key: "fortinet.voip.call_id", value: { string_value: workspace.kv.call_id } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "voip" and workspace.kv.from != null {
            true { [{ key: "fortinet.voip.from", value: { string_value: workspace.kv.from } }] }
            default { [] }
        },
        switch workspace.kv.subtype == "voip" and workspace.kv.to != null {
            true { [{ key: "fortinet.voip.to", value: { string_value: workspace.kv.to } }] }
            default { [] }
        },
        switch workspace.kv.auditreporttype != null {
            true { [{ key: "fortinet.security_rating.report_type", value: { string_value: workspace.kv.auditreporttype } }] }
            default { [] }
        },
        switch workspace.kv.auditid != null {
            true { [{ key: "fortinet.security_rating.audit_id", value: { string_value: workspace.kv.auditid } }] }
            default { [] }
        },
        switch workspace.kv.auditscore != null {
            true { [{ key: "fortinet.security_rating.score", value: { string_value: workspace.kv.auditscore } }] }
            default { [] }
        },
        switch workspace.kv.criticalcount != null {
            true { [{ key: "fortinet.security_rating.critical_count", value: { int_value: to_int(workspace.kv.criticalcount) } }] }
            default { [] }
        },
        switch workspace.kv.highcount != null {
            true { [{ key: "fortinet.security_rating.high_count", value: { int_value: to_int(workspace.kv.highcount) } }] }
            default { [] }
        },
        switch workspace.kv.mediumcount != null {
            true { [{ key: "fortinet.security_rating.medium_count", value: { int_value: to_int(workspace.kv.mediumcount) } }] }
            default { [] }
        },
        switch workspace.kv.lowcount != null {
            true { [{ key: "fortinet.security_rating.low_count", value: { int_value: to_int(workspace.kv.lowcount) } }] }
            default { [] }
        },
        switch workspace.kv.passedcount != null {
            true { [{ key: "fortinet.security_rating.passed_count", value: { int_value: to_int(workspace.kv.passedcount) } }] }
            default { [] }
        }
    )
}

// ---------------------------------------------------------------------------
// Subtype leaf: traffic → OCSF Network Activity (4001)
// ---------------------------------------------------------------------------
//
// Precondition (contract; not runtime-checked):
//   workspace.kv populated by `parse_fortigate_syslog` dispatcher or an
//   inline `parse_kv(...)` upstream of this process.
def process parse_fortigate_syslog_traffic {
    process normalize_fortigate_syslog_severity_number
    let proto_num = to_int(workspace.kv.proto)
    workspace.lsis.parsed = {
        class_uid:    4001,
        category_uid: 4,
        activity_id:  fortigate_syslog_action_to_activity_id(workspace.kv.action),
        severity_number: workspace.fortigate_syslog.severity_number,
        severity:        workspace.kv.level,
        src_endpoint: {
            ip:   workspace.kv.srcip,
            port: to_int(workspace.kv.srcport)
        },
        dst_endpoint: {
            ip:   workspace.kv.dstip,
            port: to_int(workspace.kv.dstport)
        },
        connection_info: {
            protocol_num:  proto_num,
            protocol_name: fortigate_syslog_proto_name(proto_num)
        },
        traffic: {
            bytes_in:  to_int(workspace.kv.rcvdbyte),
            bytes_out: to_int(workspace.kv.sentbyte)
        },
        metadata: fortigate_syslog_metadata(workspace.kv.osname)
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: utm:ips → OCSF Detection Finding (2004)
// ---------------------------------------------------------------------------
//
// FortiGate IPS native fields:
//   action      — verdict
//   srcip / srcport / dstip / dstport / proto
//   attack      — signature name
//   attackid    — numeric signature id
//   severity    — severity label (informational/low/medium/high/critical)
//   msg         — human-readable
def process parse_fortigate_syslog_utm_ips {
    process normalize_fortigate_syslog_severity_number
    workspace.lsis.parsed = {
        class_uid:    2004,
        category_uid: 2,
        activity_id:    1,
        severity_number: workspace.fortigate_syslog.severity_number,
        severity:        workspace.kv.level,
        disposition_id: fortigate_syslog_utm_disposition_id(workspace.kv.action),
        finding_info: {
            title: workspace.kv.attack,
            uid:   workspace.kv.attackid,
            types: ["IDS/IPS"]
        },
        attack: {
            technique: { name: workspace.kv.attack }
        },
        src_endpoint: {
            ip:   workspace.kv.srcip,
            port: to_int(workspace.kv.srcport)
        },
        dst_endpoint: {
            ip:   workspace.kv.dstip,
            port: to_int(workspace.kv.dstport)
        },
        message:  workspace.kv.msg,
        metadata: fortigate_syslog_metadata(workspace.kv.osname)
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: utm:webfilter → OCSF Web Resource Access (6004)
// ---------------------------------------------------------------------------
def process parse_fortigate_syslog_utm_webfilter {
    process normalize_fortigate_syslog_severity_number
    let activity = switch workspace.kv.action {
        "blocked"     { 2 }
        "block"       { 2 }
        "passthrough" { 1 }
        "allowed"     { 1 }
        "pass"        { 1 }
        "monitor"     { 1 }
        default       { 0 }
    }
    workspace.lsis.parsed = {
        class_uid:    6004,
        category_uid: 6,
        activity_id:  activity,
        severity_number: workspace.fortigate_syslog.severity_number,
        severity:        workspace.kv.level,
        src_endpoint: {
            ip:   workspace.kv.srcip,
            port: to_int(workspace.kv.srcport)
        },
        dst_endpoint: {
            ip:   workspace.kv.dstip,
            port: to_int(workspace.kv.dstport)
        },
        http_request: {
            url:         { url_string: workspace.kv.url },
            http_method: workspace.kv.method
        },
        web_resources: [
            {
                url:      { url_string: workspace.kv.url },
                category: workspace.kv.catdesc
            }
        ],
        actor: {
            user: { name: workspace.kv.user }
        },
        message:  workspace.kv.msg,
        metadata: fortigate_syslog_metadata(workspace.kv.osname)
    }
}

// ---------------------------------------------------------------------------
// Subtype leaf: utm:virus → OCSF Detection Finding (2004)
// ---------------------------------------------------------------------------
//
// FortiGate antivirus native fields:
//   action / srcip / dstip
//   filename — infected filename
//   checksum — file hash
//   virus    — malware family / signature
//   virusid  — numeric signature id
def process parse_fortigate_syslog_utm_antivirus {
    process normalize_fortigate_syslog_severity_number
    workspace.lsis.parsed = {
        class_uid:    2004,
        category_uid: 2,
        activity_id:    1,
        severity_number: workspace.fortigate_syslog.severity_number,
        severity:        workspace.kv.level,
        disposition_id: fortigate_syslog_utm_disposition_id(workspace.kv.action),
        finding_info: {
            title:   workspace.kv.virus,
            uid:     workspace.kv.virusid,
            types:   ["Malware"],
            src_url: { url_string: workspace.kv.ref }
        },
        malware: [
            {
                name:               workspace.kv.virus,
                classification_ids: [1]
            }
        ],
        // Real wire fields verified from captured EICAR detection (native):
        //   filename       — file name
        //   analyticscksum — file hash (SHA256)
        //   url            — full request URL (FortiOS native, not `request`)
        evidences: [
            {
                file: {
                    name:   workspace.kv.filename,
                    hashes: [{ value: workspace.kv.analyticscksum }]
                },
                url: { url_string: workspace.kv.url }
            }
        ],
        src_endpoint: {
            ip:   workspace.kv.srcip,
            port: to_int(workspace.kv.srcport)
        },
        dst_endpoint: {
            ip:   workspace.kv.dstip,
            port: to_int(workspace.kv.dstport)
        },
        message:  workspace.kv.msg,
        metadata: fortigate_syslog_metadata(workspace.kv.osname)
    }
}

