// Facade: process parse_checkpoint_leef,
//         process checkpoint_leef_to_otlp
// Category: Network firewall / IPS
// Test corpus: synthetic (anonymised RFC 5737 sample wire in this header)
//
// Vendor notes — Check Point Software Technologies — VPN-1 / FireWall-1 /
//           Quantum Security Gateway, the dominant enterprise CheckPoint
//           firewall family. Emits LEEF 2.0 records via the
//           `log_exporter` mechanism (or older OPSEC LEA). Not Cisco
//           ASA, not Juniper SRX, not PAN-OS — each in its own parser
//           file. The parser locates and extracts the LEEF block
//           itself; it does NOT consume an upstream parse_syslog.
//
// Wire —     IBM LEEF 2.0 format inside a syslog wrapper:
//             LEEF:2.0|Check Point|<Product>|<Version>|<EventID>|<TAB-separated KV>
//           Standard delimiter is a literal `\t` byte (0x09) between
//           extension key=value pairs. Some CheckPoint setups emit
//           LEEF 1.0 which is identical except for the version digit
//           and a slightly different header — the parser auto-handles
//           both by anchoring on `LEEF:` and using `\t` as the
//           extension separator.
// Bridges —  CheckPoint log_exporter emits syslog (UDP/514 or TCP/514).
//           The bridge passes the raw wire — limpid's syslog.parse
//           treats the LEEF block as opaque `msg` text, so the parser
//           splits its own header.
//
//           - syslog (UDP/TCP):
//                 { workspace.checkpoint_leef = { body: ingress, hostname: source.ip } } | parse_checkpoint_leef | compose_ocsf | ocsf_to_egress
//
// Coverage notes — non-traffic LEEF events (Authentication, VPN tunnel
//           state, etc.) route to error_log per the loud-fail-fast
//           policy and would need their own subtypes.
//
// Sample wire (anonymised to RFC 5737):
//
//   Accept (allowed connection):
//   <14>1 2026-04-30T01:23:45Z cpgw01 CheckPoint - - LEEF:2.0|Check Point|VPN-1 & FireWall-1|R81|Accept|cat=Firewall\tsrc=192.0.2.10\tdst=198.51.100.5\tsrcPort=51234\tdstPort=443\tproto=tcp\trule=12\trule_name=Allow-Internet\taction=Accept\tservice=https\tusrName=N/A
//
//   Drop (dropped by policy, silent):
//   <14>1 2026-04-30T01:24:00Z cpgw01 CheckPoint - - LEEF:2.0|Check Point|VPN-1 & FireWall-1|R81|Drop|cat=Firewall\tsrc=192.0.2.99\tdst=198.51.100.5\tsrcPort=22222\tdstPort=23\tproto=tcp\trule=99\trule_name=Cleanup-Drop\taction=Drop\tservice=telnet
//
//   Reject (rejected with TCP RST / ICMP unreachable):
//   <14>1 2026-04-30T01:24:30Z cpgw01 CheckPoint - - LEEF:2.0|Check Point|VPN-1 & FireWall-1|R81|Reject|cat=Firewall\tsrc=192.0.2.50\tdst=198.51.100.5\tsrcPort=33333\tdstPort=3389\tproto=tcp\trule=42\trule_name=Block-RDP\taction=Reject\tservice=rdp

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

include "../functions/proto_num.limpid"

// Activity / status mapping from LEEF EventID.
def function checkpoint_leef_activity_id(event_id) {
    switch event_id {
        "Accept" { 1 }                  // Open
        "Drop"   { 6 }                  // Deny
        "Reject" { 6 }                  // Deny
        "Block"  { 6 }                  // Deny
        default  { 99 }                 // Other
    }
}

def function checkpoint_leef_status_id(event_id) {
    switch event_id {
        "Accept" { 1 }                  // Success
        default  { 2 }                  // Failure (denied / dropped / rejected)
    }
}

// Extract one LEEF 2.0 KV from the tab-delimited extension block.
def function parse_checkpoint_leef_kv(ext, name) {
    let m = regex_parse(ext, "(?:^|\\t)${name}=(?P<v>[^\\t]*)")
    switch true {
        m == null { null }
        default   { m.v }
    }
}

// ---------------------------------------------------------------------------
// Main parser
// ---------------------------------------------------------------------------

// Process: parse_checkpoint_leef
// Summary: Check Point LEEF 2.0 (log_exporter syslog) traffic events → LSIS Network Activity.
// Reads: workspace.checkpoint_leef.* (bridge — see Bridges below)
//        .body (required, String) — full syslog wire
//        .hostname (optional, String) — collector-side hostname override
// Writes: workspace.lsis.parsed.*
//         .class_uid (required, Int)
def process parse_checkpoint_leef {
    // @requires: workspace.checkpoint_leef.body      (required, String)
    // @requires: workspace.checkpoint_leef.hostname  (optional, String)
    // The RFC 5424 TIMESTAMP in `.body` is the event time.
    workspace.cp_header = regex_parse(
        workspace.checkpoint_leef.body,
        "^<\\d+>1 (?P<timestamp>\\S+) \\S+ \\S+ \\S+ \\S+ LEEF:2\\.0\\|Check Point\\|(?P<product>[^|]+)\\|(?P<version>[^|]+)\\|(?P<event_id>[^|]+)\\|(?P<ext>.*)$"
    )
    switch true {
        workspace.cp_header == null {
            error "parse_checkpoint_leef: not a LEEF 2.0 / Check Point record: ${workspace.checkpoint_leef.body}"
        }
        default { process parse_checkpoint_leef_record }
    }
}

def process parse_checkpoint_leef_record {
    let ext = workspace.cp_header.ext
    let event_id = workspace.cp_header.event_id
    let activity = checkpoint_leef_activity_id(event_id)
    switch true {
        activity == 99 {
            error "parse_checkpoint_leef: unsupported LEEF EventID ${event_id}: ${workspace.checkpoint_leef.body}"
        }
        default {
            let proto = parse_checkpoint_leef_kv(ext, "proto")
            let src_port = parse_checkpoint_leef_kv(ext, "srcPort")
            let dst_port = parse_checkpoint_leef_kv(ext, "dstPort")
            workspace.lsis.parsed = {
                class_uid:    4001,
                category_uid: 4,
                activity_id:  activity,
                status_id:    checkpoint_leef_status_id(event_id),
                time:         switch workspace.cp_header.timestamp {
                    null    { null }
                    "-"     { null }
                    default { to_int(parse_datetime_rfc3339(workspace.cp_header.timestamp)) }
                },
                src_endpoint: {
                    ip:   parse_checkpoint_leef_kv(ext, "src"),
                    port: switch true {
                        src_port == null { null }
                        default          { to_int(src_port) }
                    }
                },
                dst_endpoint: {
                    ip:   parse_checkpoint_leef_kv(ext, "dst"),
                    port: switch true {
                        dst_port == null { null }
                        default          { to_int(dst_port) }
                    }
                },
                connection_info: {
                    protocol_name: proto,
                    protocol_num:  proto_num(proto)
                },
                app_name: parse_checkpoint_leef_kv(ext, "service"),
                actor: {
                    user: {
                        name: switch parse_checkpoint_leef_kv(ext, "usrName") {
                            "N/A"   { null }
                            ""      { null }
                            default { parse_checkpoint_leef_kv(ext, "usrName") }
                        }
                    }
                },
                device: {
                    hostname: workspace.checkpoint_leef.hostname,
                    vendor_name: "Check Point",
                    product: {
                        name: workspace.cp_header.product,
                        version: workspace.cp_header.version
                    }
                },
                unmapped: {
                    rule:      parse_checkpoint_leef_kv(ext, "rule"),
                    rule_name: parse_checkpoint_leef_kv(ext, "rule_name"),
                    action:    parse_checkpoint_leef_kv(ext, "action")
                },
                metadata: {
                    product: {
                        vendor_name: "Check Point",
                        name:        workspace.cp_header.product
                    },
                    version: "1.3.0"
                }
            }
        }
    }
}

def function checkpoint_leef_otlp_event_outcome(status_id) {
    switch status_id {
        1       { "success" }
        2       { "failure" }
        default { null }
    }
}

// Process: checkpoint_leef_to_otlp
// Summary: Project source facts and canonical scalars into source-owned OTLP fields.
// Reads: workspace.cp_header.*
//        .product (optional, String)
//        workspace.checkpoint_leef.*
//        .body (optional, String)
//        workspace.lsis.parsed.*
//        .status_id (optional, Int)
// Writes: workspace.lsis.shed.otlp.*
//         .resource.attributes (optional, Array)
//         .log_record.body (optional, Object)
//         .log_record.attributes (optional, Array)
def process checkpoint_leef_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Check Point" } }],
        switch workspace.cp_header.product != null {
            true { [{ key: "observer.product", value: { string_value: workspace.cp_header.product } }] }
            default { [] }
        },
        switch workspace.cp_header.version != null {
            true { [{ key: "observer.version", value: { string_value: workspace.cp_header.version } }] }
            default { [] }
        },
        [{ key: "observer.type", value: { string_value: "firewall" } }],
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.log_record.body = { string_value: workspace.checkpoint_leef.body }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: "event" } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: "network" }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: "connection" }] } } }],
        switch workspace.cp_header.event_id != null {
            true { [{ key: "event.action", value: { string_value: workspace.cp_header.event_id } }] }
            default { [] }
        },
        switch checkpoint_leef_otlp_event_outcome(workspace.lsis.parsed.status_id) != null {
            true { [{ key: "event.outcome", value: { string_value: checkpoint_leef_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.actor.user.name != null {
            true { [{ key: "user.name", value: { string_value: workspace.lsis.parsed.actor.user.name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.ip != null {
            true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.port != null {
            true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.ip != null {
            true { [{ key: "destination.ip", value: { string_value: workspace.lsis.parsed.dst_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.port != null {
            true { [{ key: "destination.port", value: { int_value: workspace.lsis.parsed.dst_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_name != null {
            true { [{ key: "network.transport", value: { string_value: workspace.lsis.parsed.connection_info.protocol_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_num != null {
            true { [{ key: "network.iana_number", value: { int_value: workspace.lsis.parsed.connection_info.protocol_num } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.app_name != null {
            true { [{ key: "network.application", value: { string_value: workspace.lsis.parsed.app_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.rule != null {
            true { [{ key: "checkpoint.rule.id", value: { string_value: workspace.lsis.parsed.unmapped.rule } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.rule_name != null {
            true { [{ key: "checkpoint.rule.name", value: { string_value: workspace.lsis.parsed.unmapped.rule_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.action != null {
            true { [{ key: "checkpoint.action", value: { string_value: workspace.lsis.parsed.unmapped.action } }] }
            default { [] }
        }
    )
}
