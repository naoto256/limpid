// Summary:     Windows Event Log JSON (NXLog field-naming shape;
//              Security channel) → LSIS, dispatched by EventID.
// Reads:       ingress (raw wire) — one Windows event record JSON object
//              per ingress
// Writes:      workspace.lsis.parsed.* — 3002 (logon/logoff), 1007 (process),
//              3001 (account change), 3006 (group management), dispatched
//              by EventID; unmapped IDs route to error_log. winevent_json_to_otlp
//              writes source-owned OTLP Resource, Scope, Body, and attributes.
// Category:    Endpoint / host audit (Windows)
// Test corpus: public (OTRF / Mordor dataset)
//
// Scope — Microsoft Windows Event Log channels (Security, System,
// Application). Operational-channel siblings like Sysmon's
// Microsoft-Windows-Sysmon/Operational are NOT covered; Sysmon has its
// own parser file. Snare Enterprise Agent's tab-separated `MSWinEventLog`
// format is the legacy syslog-only path — that has its own parser file
// (`parse_winevent_snare.limpid`, future) so this one stays JSON-only.
//
// Wire —    JSON — one event record per `ingress`. The de facto
//          shipping path on modern deployments is one of:
//            - NXLog `im_msvistalog` → `om_*` JSON
//            - Winlogbeat → ECS-shaped JSON
//            - Vector `windows_event_log` source → JSON
//            - Azure Monitor Agent (AMA) `WindowsEvent` table extract
//          The field naming convention this snippet targets is the
//          NXLog form (also used by the OTRF / Mordor public dataset),
//          which is closest to ETW raw names: `EventID`, `Channel`,
//          `EventType`, `Severity`,
//          `TargetUserName`, `SubjectUserName`, `LogonType`,
//          `IpAddress`, `IpPort`, etc.
//
// Per-EventID class mapping —
//   - 4624 / 4625 (Logon success / failure)  → 3002 Authentication
//   - 4634 / 4647 (Logoff)                   → 3002 (Logoff)
//   - 4688 / 4689 (Process create / exit)    → 1007 Process Activity
//   - 4720 (User account created)            → 3001 Account Change (Create)
//   - 4722 (Account enabled)                 → 3001 (Enable)
//   - 4725 (Account disabled)                → 3001 (Disable)
//   - 4724 (Password reset by admin)         → 3001 (Modify)
//   - 4726 (User account deleted)            → 3001 (Delete)
//   - 4732 / 4756 (Group member add)         → 3006 Group Management
//   - 4733 / 4757 (Group member remove)      → 3006
//   - everything else → error_log via the default arm
//
// Sample input (4624 logon success, abridged):
//   {"EventID":4624,"Channel":"Security",
//    "EventType":"INFO","Severity":"INFO",
//    "SourceName":"Microsoft-Windows-Security-Auditing",
//    "Hostname":"WORKSTATION1","EventTime":"2026-04-29 10:00:00",
//    "TargetUserName":"alice","TargetDomainName":"CORP",
//    "TargetUserSid":"S-1-5-21-...-1001",
//    "SubjectUserName":"-","SubjectDomainName":"-",
//    "LogonType":"3","IpAddress":"192.0.2.10","IpPort":"54321",
//    "LogonProcessName":"Kerberos","AuthenticationPackageName":"Kerberos",
//    "TargetLogonId":"0x12345","Message":"An account was successfully ..."}
//
// LogonType meaning (Windows Security Audit, used by 4624/4625):
//   2  Interactive (console)        7  Unlock
//   3  Network                      8  NetworkCleartext
//   4  Batch                        9  NewCredentials (RunAs)
//   5  Service                      10 RemoteInteractive (RDP)
//   11 CachedInteractive            -  unknown / not applicable

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// Windows EventTime is `YYYY-MM-DD HH:MM:SS` (UTC, no timezone in the
// string itself). NXLog passes through ETW's UTC timestamp; if the
// shipper's timezone is different, fix at the shipper, not here.
def function winevent_time(s) {
    switch true {
        s == null { null }
        default   { to_int(strptime(s, "%Y-%m-%d %H:%M:%S", "UTC")) }
    }
}

// Map LogonType (string, 2..11) to OCSF logon_type_id.
//   OCSF 1.3.0 logon_type_id matches Windows LogonType numerically for
//   2-11. We pass the int through (after to_int) so unknown values
//   don't drop into a hardcoded enum.
def function winevent_logon_type_id(t) {
    switch true {
        t == null { null }
        default   { to_int(t) }
    }
}

// Map NXLog's resolved Windows Event severity to OTel SeverityNumber.
def function winevent_severity_number(severity) {
    switch severity {
        "VERBOSE"       { 5 }
        "DEBUG"         { 5 }
        "INFO"          { 9 }
        "AUDIT_SUCCESS" { 9 }
        "WARNING"       { 13 }
        "ERROR"         { 17 }
        "AUDIT_FAILURE" { 17 }
        "CRITICAL"      { 21 }
        null            { null }
        default         { null }
    }
}

// Build the actor identity from SubjectUserName + SubjectDomainName
// (the principal that performed the action — for logon events this is
// the system context account; for account-management events it is the
// admin who made the change). NXLog emits `-` for the no-subject case
// (the system-context Logon/Subject pair on type-3 logons).
def function winevent_actor_user(name, domain) {
    switch true {
        name == null { null }
        name == "-"  { null }
        default      {
            switch true {
                domain == null { name }
                domain == "-"  { name }
                default        { "${domain}\\${name}" }
            }
        }
    }
}

// Best-effort device hostname: the Hostname field NXLog populates is
// the FQDN of the originating Windows host. AMA / Winlogbeat / Vector
// often emit `host.name` instead; downstream pipelines that re-parse
// those should populate `workspace.winevent.Hostname` before calling
// this snippet, or extend the field list here.

// ---------------------------------------------------------------------------
// Top-level dispatcher
// ---------------------------------------------------------------------------

def process parse_winevent_json_normalize_severity {
    workspace.winevent.source_severity = coalesce(workspace.winevent.EventType, workspace.winevent.Severity)
    workspace.winevent.severity_number = winevent_severity_number(workspace.winevent.source_severity)
    switch true {
        workspace.winevent.source_severity != null and workspace.winevent.severity_number == null {
            error "parse_winevent_json: invalid NXLog Windows Event severity ${workspace.winevent.source_severity}"
        }
    }
}

def process parse_winevent_json {
    // parse_json always returns a `Value::Object` (non-object JSON
    // is wrapped under a `_json` key per the primitive's contract);
    // a malformed JSON body fails inside parse_json itself and routes
    // the event to error_log via the standard pipeline error policy,
    // so no explicit null-check arm is needed here.
    workspace.winevent = parse_json(ingress)
    let eid = workspace.winevent.EventID
    switch true {
        // Authentication (3002)
        eid == 4624 { process parse_winevent_4624_logon_success }
        eid == 4625 { process parse_winevent_4625_logon_failure }
        eid == 4634 { process parse_winevent_4634_logoff }
        eid == 4647 { process parse_winevent_4634_logoff }
        // Process Activity (1007)
        eid == 4688 { process parse_winevent_4688_process_create }
        eid == 4689 { process parse_winevent_4689_process_terminate }
        // Account Change (3001)
        eid == 4720 { process parse_winevent_4720_account_create }
        eid == 4722 { process parse_winevent_account_enable }
        eid == 4725 { process parse_winevent_account_disable }
        eid == 4724 { process parse_winevent_account_modify }
        eid == 4726 { process parse_winevent_account_delete }
        // Group Management (3006)
        eid == 4732 { process parse_winevent_group_member_add }
        eid == 4756 { process parse_winevent_group_member_add }
        eid == 4733 { process parse_winevent_group_member_remove }
        eid == 4757 { process parse_winevent_group_member_remove }
        default { error "parse_winevent_json: unsupported EventID ${eid} on Channel ${workspace.winevent.Channel}" }
    }
}

// ---------------------------------------------------------------------------
// Helpers used by the per-EventID leaves
// ---------------------------------------------------------------------------

def function winevent_authentication_record(activity_id, status_id, severity_number, severity, time, target_user, actor_user, src_ip, src_port, logon_type, message, hostname) {
    {
        class_uid:    3002,
        category_uid: 3,
        activity_id:  activity_id,
        type_uid:     3002 * 100 + activity_id,
        severity_number: severity_number,
        severity:        severity,
        status_id:    status_id,
        time:         time,
        user:         { name: target_user },
        actor:        { user: { name: actor_user } },
        src_endpoint: { ip: src_ip, port: src_port },
        logon_type_id: logon_type,
        device:       { name: hostname },
        message:      message,
        metadata: {
            product: {
                vendor_name: "Microsoft Corporation",
                name:        "Windows Event Log"
            },
            version: "1.3.0"
        }
    }
}

def function winevent_process_activity_record(activity_id, severity_number, severity, time, process_name, command_line, parent_name, actor_user, hostname, message) {
    {
        class_uid:    1007,
        category_uid: 1,
        activity_id:  activity_id,
        type_uid:     1007 * 100 + activity_id,
        severity_number: severity_number,
        severity:        severity,
        time:         time,
        process: {
            name:         process_name,
            cmd_line:     command_line,
            parent_process: { name: parent_name }
        },
        actor:  { user: { name: actor_user } },
        device: { name: hostname },
        message: message,
        metadata: {
            product: {
                vendor_name: "Microsoft Corporation",
                name:        "Windows Event Log"
            },
            version: "1.3.0"
        }
    }
}

def function winevent_account_change_record(activity_id, severity_number, severity, time, target_user, actor_user, hostname, message) {
    {
        class_uid:    3001,
        category_uid: 3,
        activity_id:  activity_id,
        type_uid:     3001 * 100 + activity_id,
        severity_number: severity_number,
        severity:        severity,
        time:         time,
        user:   { name: target_user },
        actor:  { user: { name: actor_user } },
        device: { name: hostname },
        message: message,
        metadata: {
            product: {
                vendor_name: "Microsoft Corporation",
                name:        "Windows Event Log"
            },
            version: "1.3.0"
        }
    }
}

def function winevent_group_management_record(activity_id, severity_number, severity, time, group_name, member, actor_user, hostname, message) {
    {
        class_uid:    3006,
        category_uid: 3,
        activity_id:  activity_id,
        type_uid:     3006 * 100 + activity_id,
        severity_number: severity_number,
        severity:        severity,
        time:         time,
        group:  { name: group_name },
        user:   { name: member },
        actor:  { user: { name: actor_user } },
        device: { name: hostname },
        message: message,
        metadata: {
            product: {
                vendor_name: "Microsoft Corporation",
                name:        "Windows Event Log"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Authentication leaves (3002)
// ---------------------------------------------------------------------------

def process parse_winevent_4624_logon_success {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_authentication_record(
        1, 1, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        switch we.IpAddress { "-" { null } default { we.IpAddress } },
        switch we.IpPort { "-" { null } default { to_int(we.IpPort) } },
        winevent_logon_type_id(we.LogonType),
        "Windows logon success",
        we.Hostname
    )
}

def process parse_winevent_4625_logon_failure {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_authentication_record(
        1, 2, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        switch we.IpAddress { "-" { null } default { we.IpAddress } },
        switch we.IpPort { "-" { null } default { to_int(we.IpPort) } },
        winevent_logon_type_id(we.LogonType),
        "Windows logon failure (status=${we.Status} substatus=${we.SubStatus})",
        we.Hostname
    )
}

def process parse_winevent_4634_logoff {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_authentication_record(
        2, 1, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        null,
        null,
        null,
        winevent_logon_type_id(we.LogonType),
        "Windows logoff",
        we.Hostname
    )
}

// ---------------------------------------------------------------------------
// Process Activity leaves (1007)
// ---------------------------------------------------------------------------

def process parse_winevent_4688_process_create {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_process_activity_record(
        1, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        we.NewProcessName,
        we.CommandLine,
        we.ParentProcessName,
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "Process created"
    )
}

def process parse_winevent_4689_process_terminate {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_process_activity_record(
        4, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        we.ProcessName,
        null,
        null,
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "Process terminated (status=${we.Status})"
    )
}

// ---------------------------------------------------------------------------
// Account Change leaves (3001)
// ---------------------------------------------------------------------------

def process parse_winevent_4720_account_create {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_account_change_record(
        1, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "User account created"
    )
}

def process parse_winevent_account_enable {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_account_change_record(
        2, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "User account enabled"
    )
}

def process parse_winevent_account_disable {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_account_change_record(
        3, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "User account disabled"
    )
}

def process parse_winevent_account_modify {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_account_change_record(
        99, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "User account password reset by admin"
    )
}

def process parse_winevent_account_delete {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_account_change_record(
        4, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        winevent_actor_user(we.TargetUserName, we.TargetDomainName),
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "User account deleted"
    )
}

// ---------------------------------------------------------------------------
// Group Management leaves (3006)
// ---------------------------------------------------------------------------

def process parse_winevent_group_member_add {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_group_management_record(
        1, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        we.TargetUserName,
        we.MemberName,
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "Group member added"
    )
}

def process parse_winevent_group_member_remove {
    process parse_winevent_json_normalize_severity
    let we = workspace.winevent
    workspace.lsis.parsed = winevent_group_management_record(
        2, we.severity_number, we.source_severity,
        winevent_time(we.EventTime),
        we.TargetUserName,
        we.MemberName,
        winevent_actor_user(we.SubjectUserName, we.SubjectDomainName),
        we.Hostname,
        "Group member removed"
    )
}

def function winevent_json_otlp_event_category(class_uid) {
    switch class_uid {
        1007 { "process" }
        3001 { "iam" }
        3006 { "iam" }
        default { "authentication" }
    }
}

def function winevent_json_otlp_event_type(class_uid, activity_id) {
    switch class_uid {
        1007 { switch activity_id { 2 { "end" } default { "start" } } }
        3001 { "change" }
        3006 { "change" }
        default { switch activity_id { 2 { "end" } default { "start" } } }
    }
}

def function winevent_json_otlp_event_outcome(status_id) {
    switch status_id { 1 { "success" } 2 { "failure" } default { null } }
}

def process winevent_json_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Microsoft" } }],
        [{ key: "observer.product", value: { string_value: "Windows Event Log" } }],
        [{ key: "observer.type", value: { string_value: "host" } }],
        switch workspace.winevent.Hostname != null { true { [{ key: "host.name", value: { string_value: workspace.winevent.Hostname } }] } default { [] } },
        switch workspace.winevent.SourceName != null { true { [{ key: "service.name", value: { string_value: workspace.winevent.SourceName } }] } default { [] } },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.scope.name = workspace.winevent.Channel
    workspace.lsis.shed.otlp.log_record.body = { string_value: ingress }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: "event" } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: winevent_json_otlp_event_category(workspace.lsis.parsed.class_uid) }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: winevent_json_otlp_event_type(workspace.lsis.parsed.class_uid, workspace.lsis.parsed.activity_id) }] } } }],
        switch workspace.winevent.EventID != null { true { [{ key: "event.code", value: { string_value: "${workspace.winevent.EventID}" } }] } default { [] } },
        switch winevent_json_otlp_event_outcome(workspace.lsis.parsed.status_id) != null { true { [{ key: "event.outcome", value: { string_value: winevent_json_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] } default { [] } },
        switch workspace.lsis.parsed.actor.user.name != null { true { [{ key: "user.name", value: { string_value: workspace.lsis.parsed.actor.user.name } }] } default { [] } },
        switch workspace.lsis.parsed.user.name != null { true { [{ key: "user.target.name", value: { string_value: workspace.lsis.parsed.user.name } }] } default { [] } },
        switch workspace.lsis.parsed.process.name != null { true { [{ key: "process.name", value: { string_value: workspace.lsis.parsed.process.name } }] } default { [] } },
        switch workspace.lsis.parsed.process.parent_process.name != null { true { [{ key: "process.parent.name", value: { string_value: workspace.lsis.parsed.process.parent_process.name } }] } default { [] } },
        switch workspace.lsis.parsed.src_endpoint.ip != null { true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] } default { [] } },
        switch workspace.lsis.parsed.src_endpoint.port != null { true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] } default { [] } }
    )
}
