// Microsoft Sysmon parser (vocabulary)
//
// Summary:     Microsoft Sysmon Windows-event JSON (forwarder-shipped) → LSIS,
//              dispatched by EventID.
// Reads:       workspace.sysmon.* (bridge — see Bridges below)
//   .body (required, Object) — parsed Sysmon event (caller does `parse_json(ingress)`)
//   .hostname (optional, String) — collector override
// Writes:      workspace.lsis.parsed.* — EventID 1 (ProcessCreate) → 1007,
//              3 (NetworkConnect) → 4001, 11 (FileCreate) → 1001;
//              unknown EventIDs route to error_log. sysmon_to_otlp writes
//              source-owned OTLP Resource, Scope, Body, and attributes.
// Category:    EDR
// Test corpus: spec-only (Sysmon event schema reference; EventIDs 1 / 3 / 11
//              only — the bulk of EDR/SOC consumption)
//
// Vendor notes — Microsoft Sysinternals Sysmon (System Monitor) — the
//           Windows kernel telemetry agent that produces detailed
//           process / network / file / registry / DNS events via the
//           `Microsoft-Windows-Sysmon/Operational` Windows Event Log
//           channel. Distinct from the built-in Windows Security
//           event channel (handled by `parse_winevent_json`); Sysmon
//           is opt-in (deploy + config XML) but produces strictly
//           richer telemetry for EDR / SIEM correlation.
// Wire —     Sysmon events arrive as Windows Event Log records, which
//           a forwarder (NXLog / Vector / Winlogbeat) ships as JSON.
//           The relevant fields are —
//             EventID        — Sysmon-specific (1=ProcessCreate,
//                              3=NetworkConnect, 11=FileCreate, …)
//             Channel        — "Microsoft-Windows-Sysmon/Operational"
//             EventTime      — RFC 3339 timestamp
//             Computer       — Windows machine name
//             EventData      — Object with event-type-specific keys
//                              (Image, CommandLine, ProcessId, etc.)
// Bridges —  Sysmon JSON typically arrives via:
//
//           - NXLog / Vector / Winlogbeat over TCP/syslog (most common):
//                 process parse_syslog | {
//                     workspace.sysmon = {
//                         body:     parse_json(workspace.syslog.msg),
//                         hostname: workspace.syslog.hostname
//                     }
//                 } | parse_sysmon | compose_ocsf | ocsf_to_egress
//
//           - Direct JSON-line tail (when the forwarder writes a JSONL file):
//                 process { workspace.sysmon = { body: parse_json(ingress), hostname: hostname() } } | parse_sysmon | compose_ocsf | ocsf_to_egress
//
// Coverage scope (v0.7.1):
//
//   | EventID | Sysmon name        | OCSF class                     |
//   |---------|--------------------|--------------------------------|
//   | 1       | ProcessCreate      | 1007 Process Activity / Launch |
//   | 3       | NetworkConnect     | 4001 Network Activity / Open   |
//   | 11      | FileCreate         | 1001 File System Activity / Create |
//
//   Sysmon emits 25+ event types; the three above cover the bulk of
//   what EDR / SOC use cases consume. Others (5 ProcessTerminate,
//   7 ImageLoad, 8 CreateRemoteThread, 12-14 Registry, 22 DnsQuery,
//   etc.) route to error_log and would each need their own leaf with
//   their event-data shape.

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// Strip a Windows path down to its basename ("C:\\Windows\\cmd.exe" → "cmd.exe").
// Sysmon's Image / ParentImage are always full paths.
def function sysmon_basename(path) {
    let m = regex_parse(path, "(?P<name>[^\\\\]+)$")
    switch true {
        m == null { path }
        default   { m.name }
    }
}

include "../functions/proto_num.limpid"

// ---------------------------------------------------------------------------
// Main parser
// ---------------------------------------------------------------------------

def process parse_sysmon {
    // @requires: workspace.sysmon.body      (required, Object — already parse_json'd)
    // @requires: workspace.sysmon.hostname  (optional, String)
    // `body.EventTime` is the event time and is normalized from RFC 3339.
    workspace.sysmon.time = to_int(parse_datetime_rfc3339(workspace.sysmon.body.EventTime))
    switch workspace.sysmon.body.EventID {
        1  { process parse_sysmon_process_create }
        3  { process parse_sysmon_network_connect }
        11 { process parse_sysmon_file_create }
        default {
            error "parse_sysmon: unsupported Sysmon EventID ${workspace.sysmon.body.EventID}"
        }
    }
}

// ---------------------------------------------------------------------------
// EventID 1: ProcessCreate → OCSF 1007 Process Activity / Launch
// ---------------------------------------------------------------------------

def process parse_sysmon_process_create {
    let ed = workspace.sysmon.body.EventData
    workspace.lsis.parsed = {
        class_uid:    1007,
        category_uid: 1,
        activity_id:  1,                                // Launch
        status_id:    1,                                // Success
        time:         workspace.sysmon.time,
        process: {
            name:     sysmon_basename(ed.Image),
            pid:      to_int(ed.ProcessId),
            cmd_line: ed.CommandLine,
            file: {
                path:   ed.Image,
                hashes: ed.Hashes,
                product: {
                    name:    ed.Product,
                    vendor_name: ed.Company,
                    version: ed.FileVersion
                }
            },
            integrity_id: switch ed.IntegrityLevel {
                "System"        { 4 }
                "High"          { 3 }
                "Medium"        { 2 }
                "Low"           { 1 }
                "Untrusted"     { 0 }
                default         { null }
            },
            session: {
                uid: ed.LogonId
            }
        },
        actor: {
            user: {
                name: ed.User
            },
            process: {
                name:     sysmon_basename(ed.ParentImage),
                pid:      to_int(ed.ParentProcessId),
                cmd_line: ed.ParentCommandLine,
                file: {
                    path: ed.ParentImage
                }
            }
        },
        device: {
            hostname: coalesce(workspace.sysmon.hostname, workspace.sysmon.body.Computer)
        },
        unmapped: {
            ProcessGuid:       ed.ProcessGuid,
            ParentProcessGuid: ed.ParentProcessGuid,
            CurrentDirectory:  ed.CurrentDirectory,
            RuleName:          ed.RuleName
        },
        metadata: {
            product: {
                vendor_name: "Microsoft",
                name:        "Sysmon"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// EventID 3: NetworkConnect → OCSF 4001 Network Activity / Open
// ---------------------------------------------------------------------------

def process parse_sysmon_network_connect {
    let ed = workspace.sysmon.body.EventData
    workspace.lsis.parsed = {
        class_uid:    4001,
        category_uid: 4,
        activity_id:  1,                                // Open
        status_id:    1,
        time:         workspace.sysmon.time,
        src_endpoint: {
            ip:       ed.SourceIp,
            port:     to_int(ed.SourcePort),
            hostname: ed.SourceHostname
        },
        dst_endpoint: {
            ip:       ed.DestinationIp,
            port:     to_int(ed.DestinationPort),
            hostname: ed.DestinationHostname
        },
        connection_info: {
            protocol_name: ed.Protocol,
            protocol_num:  proto_num(ed.Protocol),
            direction_id:  switch ed.Initiated {
                "true"  { 1 }                          // Outbound
                "false" { 2 }                          // Inbound
                default { 0 }
            }
        },
        actor: {
            user: {
                name: ed.User
            },
            process: {
                name:     sysmon_basename(ed.Image),
                pid:      to_int(ed.ProcessId),
                file: {
                    path: ed.Image
                }
            }
        },
        device: {
            hostname: coalesce(workspace.sysmon.hostname, workspace.sysmon.body.Computer)
        },
        unmapped: {
            ProcessGuid: ed.ProcessGuid,
            RuleName:    ed.RuleName
        },
        metadata: {
            product: {
                vendor_name: "Microsoft",
                name:        "Sysmon"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// EventID 11: FileCreate → OCSF 1001 File System Activity / Create
// ---------------------------------------------------------------------------

def process parse_sysmon_file_create {
    let ed = workspace.sysmon.body.EventData
    workspace.lsis.parsed = {
        class_uid:    1001,
        category_uid: 1,
        activity_id:  1,                                // Create
        status_id:    1,
        time:         workspace.sysmon.time,
        file: {
            name: sysmon_basename(ed.TargetFilename),
            path: ed.TargetFilename
        },
        actor: {
            user: {
                name: ed.User
            },
            process: {
                name:     sysmon_basename(ed.Image),
                pid:      to_int(ed.ProcessId),
                file: {
                    path: ed.Image
                }
            }
        },
        device: {
            hostname: coalesce(workspace.sysmon.hostname, workspace.sysmon.body.Computer)
        },
        unmapped: {
            ProcessGuid:      ed.ProcessGuid,
            CreationUtcTime:  ed.CreationUtcTime,
            RuleName:         ed.RuleName
        },
        metadata: {
            product: {
                vendor_name: "Microsoft",
                name:        "Sysmon"
            },
            version: "1.3.0"
        }
    }
}

def function sysmon_otlp_event_category(class_uid) {
    switch class_uid { 1001 { "file" } 1007 { "process" } default { "network" } }
}

def function sysmon_otlp_event_type(class_uid) {
    switch class_uid { 1001 { "creation" } 1007 { "start" } default { "connection" } }
}

def process sysmon_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Microsoft" } }],
        [{ key: "observer.product", value: { string_value: "Sysmon" } }],
        [{ key: "observer.type", value: { string_value: "host" } }],
        switch workspace.sysmon.body.Computer != null { true { [{ key: "host.name", value: { string_value: workspace.sysmon.body.Computer } }] } default { [] } },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.scope.name = "Microsoft-Windows-Sysmon"
    workspace.lsis.shed.otlp.log_record.body = { string_value: ingress }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: "event" } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: sysmon_otlp_event_category(workspace.lsis.parsed.class_uid) }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: sysmon_otlp_event_type(workspace.lsis.parsed.class_uid) }] } } }],
        [{ key: "event.code", value: { string_value: "${workspace.sysmon.body.EventID}" } }],
        switch workspace.lsis.parsed.actor.user.name != null { true { [{ key: "user.name", value: { string_value: workspace.lsis.parsed.actor.user.name } }] } default { [] } },
        switch workspace.lsis.parsed.process.name != null { true { [{ key: "process.name", value: { string_value: workspace.lsis.parsed.process.name } }] } default { [] } },
        switch workspace.lsis.parsed.process.pid != null { true { [{ key: "process.pid", value: { int_value: workspace.lsis.parsed.process.pid } }] } default { [] } },
        switch workspace.lsis.parsed.process.parent_process.name != null { true { [{ key: "process.parent.name", value: { string_value: workspace.lsis.parsed.process.parent_process.name } }] } default { [] } },
        switch workspace.lsis.parsed.process.parent_process.pid != null { true { [{ key: "process.parent.pid", value: { int_value: workspace.lsis.parsed.process.parent_process.pid } }] } default { [] } },
        switch workspace.lsis.parsed.src_endpoint.ip != null { true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] } default { [] } },
        switch workspace.lsis.parsed.src_endpoint.port != null { true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] } default { [] } },
        switch workspace.lsis.parsed.dst_endpoint.ip != null { true { [{ key: "destination.ip", value: { string_value: workspace.lsis.parsed.dst_endpoint.ip } }] } default { [] } },
        switch workspace.lsis.parsed.dst_endpoint.port != null { true { [{ key: "destination.port", value: { int_value: workspace.lsis.parsed.dst_endpoint.port } }] } default { [] } },
        switch workspace.lsis.parsed.connection_info.protocol_name != null { true { [{ key: "network.transport", value: { string_value: workspace.lsis.parsed.connection_info.protocol_name } }] } default { [] } },
        switch workspace.lsis.parsed.file.name != null { true { [{ key: "file.name", value: { string_value: workspace.lsis.parsed.file.name } }] } default { [] } },
        switch workspace.lsis.parsed.file.path != null { true { [{ key: "file.path", value: { string_value: workspace.lsis.parsed.file.path } }] } default { [] } }
    )
}
