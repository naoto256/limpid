// Summary:     Trellix (McAfee) Network Security Platform standard-template KV
//              alerts → LSIS Detection Finding.
// Reads:       workspace.nsp.* (bridge — see Bridges below)
//                .body (required, String) — the KV body
//                .hostname (optional, String) — collector-side hostname
//                .timezone (optional, String) — source timezone override as an
//                  IANA name or fixed offset for attack_time values without
//                  ` UTC`; defaults to the limpid host's system timezone
//                  (the standard-template timestamp zone is not specified in
//                  the available vendor documentation; explicit ` UTC` is
//                  interpreted as UTC. The default assumes the Manager and
//                  limpid share the same correct system timezone — the most
//                  likely deployment when the zone is undocumented; override
//                  it or use a custom parser when the source differs)
// Writes:      workspace.lsis.parsed.* — 2004 (Detection Finding);
//              nsp_to_otlp writes source-owned OTLP Resource, Body, and
//              LogRecord attributes.
// Category:    Network firewall / IPS
// Test corpus: real (Trellix NSP Manager capture — 56/56 alerts across HTTP /
//              SSH / SSL / NETBIOS-SS / TELNET / NTP / BACKDOOR signature
//              categories)
//
// Vendor notes — Trellix (formerly McAfee) Network Security Platform — the
//           inline IPS appliance product. Wire format below is the
//           **vendor-recommended standard template** for the syslog
//           forwarder ("Custom Syslog" notification with the standard
//           field list). Operators with custom templates would need to
//           fork this parser; the canonical template covers the
//           ~95% case.
//
// Wire —     Space-separated `key=value` pairs (quoted-string values
//           when the value contains spaces). The full standard
//           template field set:
//             admin_domain alert_id alert_type app_protocol
//             confidence attack_count attack_id attack_name severity
//             alert_signature attack_time category dest_ip dest_name
//             dest_port device_name direction confidence file_name
//             file_hash file_type virus_name action_status
//             error_status protocol result src_ip src_name src_port
//
//           Note the **duplicate `confidence=` key**: NSP's standard
//           template emits attack-confidence first and
//           malware-confidence second under the same key name. The
//           parser regex-extracts each by position so neither is lost
//           to last-wins KV parsing.
// Bridges —  NSP sensors forward via syslog (typically UDP/514). The
//           bridge passes the raw KV body (post-syslog-strip if the
//           sensor wraps in syslog framing, or `ingress` directly
//           if not). Two typical bridges:
//
//           - syslog transport (sensor emits with syslog wrapper):
//                 process parse_syslog | {
//                     workspace.nsp = {
//                         body:     workspace.syslog.msg,
//                         hostname: workspace.syslog.hostname,
//                         timezone: "+00:00"
//                     }
//                 } | parse_nsp | compose_ocsf | ocsf_to_egress
//
//           - raw forwarder (sensor → text-only forwarder → limpid tail):
//                 { workspace.nsp = { body: ingress, hostname: hostname(), timezone: "+00:00" } } | parse_nsp | compose_ocsf | ocsf_to_egress
//
// Sample bodies (synthetic, anonymised to RFC 5737):
//
//   Attack alert (no malware fields populated):
//   admin_domain=Default alert_id=12345 alert_type=Signature app_protocol=HTTP confidence=Tentative attack_count=1 attack_id=0x40000123 attack_name="HTTP: SQL Injection Attempt" severity=High alert_signature="HTTP:SQL-INJ:001" attack_time="2026-05-16 10:00:00" category="Application Layer" dest_ip=192.0.2.10 dest_name=webserver01 dest_port=80 device_name=nsp-sensor-01 direction=Inbound confidence= file_name= file_hash= file_type= virus_name= action_status= error_status= protocol=TCP result=Blocked src_ip=198.51.100.5 src_name= src_port=54321
//
//   Malware detection (file + virus fields populated):
//   admin_domain=Default alert_id=12346 alert_type=Malware app_protocol=SMB confidence=High attack_count=1 attack_id=0x50000456 attack_name="Malware: Win32.Generic Backdoor" severity=Critical alert_signature="MALWARE:WIN32:GEN" attack_time="2026-05-16 10:01:00" category=Malware dest_ip=192.0.2.20 dest_name=fileserver02 dest_port=445 device_name=nsp-sensor-01 direction=Inbound confidence=Definitive file_name="payload.exe" file_hash=d41d8cd98f00b204e9800998ecf8427e file_type=PE32 virus_name=Win32/Generic.Backdoor action_status=blocked error_status= protocol=TCP result=Quarantined src_ip=198.51.100.6 src_name= src_port=54322
//
//   Reconnaissance / alert-only (no action taken):
//   admin_domain=Default alert_id=12347 alert_type=Reconnaissance app_protocol=ICMP confidence=Tentative attack_count=5 attack_id=0x30000789 attack_name="ICMP: Network Sweep" severity=Low alert_signature="ICMP:SWEEP:001" attack_time="2026-05-16 10:02:00" category=Reconnaissance dest_ip=192.0.2.30 dest_name= dest_port= device_name=nsp-sensor-01 direction=Inbound confidence= file_name= file_hash= file_type= virus_name= action_status= error_status= protocol=ICMP result=Alert src_ip=198.51.100.7 src_name= src_port=
//
// Coverage notes — the wire format observed on the real Manager omits
// the quotes the documented template suggests
// (e.g. `attack_name=NETBIOS-SS: Windows SMB Remote Code Execution
// Vulnerability` is unquoted with embedded spaces); the boundary-aware
// `parse_nsp_kv` helper below handles this correctly. Custom templates
// (operator-defined field subsets, alternate key names) would still
// need a forked parser.

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// Map the source NSP severity to OTel SeverityNumber.
def function nsp_severity_number(s) {
    switch s {
        "Informational" { 9 }
        "Low"           { 13 }
        "Medium"        { 17 }
        "High"          { 19 }
        "Critical"      { 21 }
        null             { null }
        default          { null }
    }
}

// Map NSP protocol name to OCSF protocol_num (IANA).
def function nsp_protocol_num(p) {
    switch p {
        "TCP"    { 6 }
        "UDP"    { 17 }
        "ICMP"   { 1 }
        "ICMPv6" { 58 }
        "GRE"    { 47 }
        "ESP"    { 50 }
        default  { null }
    }
}

// Map NSP `result=` to OCSF status_id.
//   Blocked / Quarantined / Dropped → 2 (Failure — offending traffic stopped)
//   Alert (alert-only, no action)    → 99 (Other)
//   Allowed                          → 1 (Success — passed through)
def function nsp_status_id(r) {
    switch r {
        "Blocked"     { 2 }
        "Quarantined" { 2 }
        "Dropped"     { 2 }
        "Allowed"     { 1 }
        "Alert"       { 99 }
        default       { 99 }
    }
}

// NSP-style direction → OCSF direction_id (1=Inbound, 2=Outbound, 3=Lateral).
def function nsp_direction_id(d) {
    switch d {
        "Inbound"  { 1 }
        "Outbound" { 2 }
        "Lateral"  { 3 }
        default    { 0 }
    }
}

// `to_int` that tolerates the empty-string sentinel NSP uses for "no
// value" (`dest_port=`). Returns null instead of erroring.
def function nsp_to_int_opt(s) {
    switch true {
        s == null { null }
        s == ""   { null }
        default   { to_int(s) }
    }
}

// Single-shot extractor for the Trellix NSP standard syslog template.
//
// Why one big regex instead of `parse_kv` or per-field extraction:
//
//   - The real NSP Manager wire format emits **unquoted**
//     multi-word values for free-form fields:
//
//       attack_name=NETBIOS-SS: Windows SMB Remote Code Execution Vulnerability severity=Medium ...
//       attack_time=2026-05-16 11:27:53 UTC category=Exploit ...
//
//     The documented template suggests these are quoted
//     (`attack_name="..."`), but the real Manager omits the quotes.
//     `parse_kv` (space-splits) would lose everything after the first
//     word; boundary-detection by `\s\w+=` depends on regex
//     backtracking behaviour that regex-lite handles unevenly.
//
//   - The Trellix standard template is **fixed-order** (vendor-defined,
//     operator does not reorder it). So instead of detecting boundaries
//     heuristically, the regex hard-codes the exact sequence of keys
//     and uses each literal next key as the unambiguous boundary for
//     the previous value's `.*?`. One `regex_parse` per event extracts
//     all 27 fields plus both `confidence=` occurrences (the duplicate
//     key — attack confidence first, malware confidence second — is
//     resolved naturally by giving the two captures different names).
//
//   - Failure mode is loud-fail-fast (limpid policy): if even one key
//     is missing or out of order, the whole regex fails and the event
//     routes to error_log. Custom templates with reordered or
//     different key sets need a forked parser.
def function parse_nsp_extract(body) {
    regex_parse(
        body,
        "admin_domain=(?P<admin_domain>.*?) alert_id=(?P<alert_id>.*?) alert_type=(?P<alert_type>.*?) app_protocol=(?P<app_protocol>.*?) confidence=(?P<confidence_attack>.*?) attack_count=(?P<attack_count>.*?) attack_id=(?P<attack_id>.*?) attack_name=(?P<attack_name>.*?) severity=(?P<severity>.*?) alert_signature=(?P<alert_signature>.*?) attack_time=(?P<attack_time>.*?) category=(?P<category>.*?) dest_ip=(?P<dest_ip>.*?) dest_name=(?P<dest_name>.*?) dest_port=(?P<dest_port>.*?) device_name=(?P<device_name>.*?) direction=(?P<direction>.*?) confidence=(?P<confidence_malware>.*?) file_name=(?P<file_name>.*?) file_hash=(?P<file_hash>.*?) file_type=(?P<file_type>.*?) virus_name=(?P<virus_name>.*?) action_status=(?P<action_status>.*?) error_status=(?P<error_status>.*?) protocol=(?P<protocol>.*?) result=(?P<result>.*?) src_ip=(?P<src_ip>.*?) src_name=(?P<src_name>.*?) src_port=(?P<src_port>.*)$"
    )
}

// Build the OCSF Detection Finding (2004) record. `nsp` is the
// parse_kv result; `confs` is the per-confidence object from
// `parse_nsp_confidence`.
def function nsp_finding_record(nsp, host, time_ns, severity_number, severity) {
    {
        class_uid:       2004,
        category_uid:    2,
        activity_id:     1,                             // Create (new finding)
        severity_number: severity_number,
        severity:        severity,
        status_id:       nsp_status_id(nsp.result),
        time:            time_ns,
        finding_info: {
            uid:                nsp.alert_id,
            title:              nsp.attack_name,
            types:              ["Network IDS"],
            confidence:         nsp.confidence_attack,
            analytic: {
                name: nsp.alert_signature,
                uid:  nsp.attack_id
            }
        },
        attacks: [{
            technique: {
                name: nsp.attack_name,
                uid:  nsp.attack_id
            }
        }],
        malware: switch true {
            nsp.virus_name != null and nsp.virus_name != "" {
                [{
                    name:        nsp.virus_name,
                    classification_ids: [99],
                    provider:    "Trellix NSP"
                }]
            }
            default { null }
        },
        evidences: switch true {
            nsp.file_hash != null and nsp.file_hash != "" {
                [{
                    file: {
                        name: switch true {
                            nsp.file_name != "" { nsp.file_name }
                            default             { null }
                        },
                        type: switch true {
                            nsp.file_type != "" { nsp.file_type }
                            default             { null }
                        },
                        hashes: [{
                            algorithm_id: 1,                  // 1=MD5 (NSP standard hash)
                            value:        nsp.file_hash
                        }]
                    }
                }]
            }
            default { null }
        },
        src_endpoint: {
            ip:        nsp.src_ip,
            port:      nsp_to_int_opt(nsp.src_port),
            hostname:  switch true {
                nsp.src_name != "" { nsp.src_name }
                default            { null }
            }
        },
        dst_endpoint: {
            ip:        nsp.dest_ip,
            port:      nsp_to_int_opt(nsp.dest_port),
            hostname:  switch true {
                nsp.dest_name != "" { nsp.dest_name }
                default             { null }
            }
        },
        connection_info: {
            protocol_num:  nsp_protocol_num(nsp.protocol),
            protocol_name: nsp.protocol,
            direction_id:  nsp_direction_id(nsp.direction)
        },
        app_name: nsp.app_protocol,
        device: {
            hostname: coalesce(
                switch true { nsp.device_name != null and nsp.device_name != "" { nsp.device_name } default { null } },
                host
            )
        },
        unmapped: {
            admin_domain:  nsp.admin_domain,
            alert_type:    nsp.alert_type,
            category:      nsp.category,
            attack_count:  nsp.attack_count,
            attack_time:   nsp.attack_time,
            malware_confidence: nsp.confidence_malware,
            action_status: nsp.action_status,
            error_status:  nsp.error_status,
            result:        nsp.result
        },
        metadata: {
            product: {
                vendor_name: "Trellix",
                name:        "Network Security Platform"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Main parser
// ---------------------------------------------------------------------------

def process parse_nsp_normalize_severity {
    let severity = switch workspace.nsp_kv.severity {
        ""      { null }
        "N/A"   { null }
        default { workspace.nsp_kv.severity }
    }
    let severity_number = nsp_severity_number(severity)
    switch true {
        severity != null and severity_number == null {
            error "parse_nsp: invalid Trellix NSP severity ${severity}"
        }
        default {
            workspace.nsp_severity = {
                number: severity_number,
                text:   severity
            }
        }
    }
}

def process parse_nsp_normalize_time {
    switch workspace.nsp.timezone {
        "local" { error "parse_nsp: source timezone must be an IANA name or fixed offset, not local" }
    }
    let source_timezone = coalesce(workspace.nsp.timezone, "local")
    workspace.nsp.timezone_probe = strptime(
        "2000-01-15 12:00:00",
        "%Y-%m-%d %H:%M:%S",
        source_timezone
    )
    let quoted = regex_parse(workspace.nsp_kv.attack_time, "^\"(?P<value>.*)\"$")
    let source_time = coalesce(quoted.value, workspace.nsp_kv.attack_time)
    let explicit_utc = regex_parse(source_time, "^(?P<value>.*) UTC$")
    workspace.nsp.time = switch true {
        source_time == null { null }
        source_time == ""   { null }
        source_time == "N/A" { null }
        explicit_utc != null {
            to_int(strptime(explicit_utc.value, "%Y-%m-%d %H:%M:%S", "UTC"))
        }
        default {
            to_int(strptime(source_time, "%Y-%m-%d %H:%M:%S", source_timezone))
        }
    }
}

def process parse_nsp {
    // @requires: workspace.nsp.body      (required, String)
    // @requires: workspace.nsp.hostname  (optional, String)
    // @requires: workspace.nsp.timezone  (optional, String — IANA name or fixed offset)
    //
    // We do NOT use parse_kv here — see parse_nsp_extract() doc above
    // for why: real Trellix NSP Manager emits unquoted multi-word
    // values and the standard template is fixed-order.
    workspace.nsp_kv = parse_nsp_extract(workspace.nsp.body)
    switch true {
        // parse_nsp_extract returns null when the wire deviates from
        // the standard template (missing key / reordered / extra
        // fields). Loud-fail-fast per limpid policy.
        workspace.nsp_kv == null {
            error "parse_nsp: not a Trellix NSP standard-template body: ${workspace.nsp.body}"
        }
        default {
            process parse_nsp_normalize_severity
            process parse_nsp_normalize_time
            workspace.lsis.parsed = nsp_finding_record(
                workspace.nsp_kv,
                workspace.nsp.hostname,
                workspace.nsp.time,
                workspace.nsp_severity.number,
                workspace.nsp_severity.text
            )
        }
    }
}

def function nsp_otlp_event_outcome(status_id) {
    switch status_id {
        1       { "success" }
        2       { "failure" }
        default { null }
    }
}

def process nsp_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Trellix" } }],
        [{ key: "observer.product", value: { string_value: "Network Security Platform" } }],
        [{ key: "observer.type", value: { string_value: "ids" } }],
        switch workspace.nsp_kv.device_name != null and workspace.nsp_kv.device_name != "" {
            true { [{ key: "host.name", value: { string_value: workspace.nsp_kv.device_name } }] }
            default { [] }
        },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.log_record.body = { string_value: workspace.nsp.body }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: "alert" } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: "intrusion_detection" }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: "indicator" }] } } }],
        switch workspace.nsp_kv.result != null and workspace.nsp_kv.result != "" {
            true { [{ key: "event.action", value: { string_value: workspace.nsp_kv.result } }] }
            default { [] }
        },
        switch nsp_otlp_event_outcome(workspace.lsis.parsed.status_id) != null {
            true { [{ key: "event.outcome", value: { string_value: nsp_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.ip != null {
            true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.port != null {
            true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.hostname != null {
            true { [{ key: "source.domain", value: { string_value: workspace.lsis.parsed.src_endpoint.hostname } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.ip != null {
            true { [{ key: "destination.ip", value: { string_value: workspace.lsis.parsed.dst_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.port != null {
            true { [{ key: "destination.port", value: { int_value: workspace.lsis.parsed.dst_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.hostname != null {
            true { [{ key: "destination.domain", value: { string_value: workspace.lsis.parsed.dst_endpoint.hostname } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_name != null {
            true { [{ key: "network.transport", value: { string_value: workspace.lsis.parsed.connection_info.protocol_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_num != null {
            true { [{ key: "network.iana_number", value: { int_value: workspace.lsis.parsed.connection_info.protocol_num } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.app_name != null {
            true { [{ key: "network.application", value: { string_value: workspace.lsis.parsed.app_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.title != null {
            true { [{ key: "rule.name", value: { string_value: workspace.lsis.parsed.finding_info.title } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.uid != null {
            true { [{ key: "event.id", value: { string_value: workspace.lsis.parsed.finding_info.uid } }] }
            default { [] }
        },
        switch workspace.nsp_kv.attack_id != null and workspace.nsp_kv.attack_id != "" {
            true { [{ key: "rule.id", value: { string_value: workspace.nsp_kv.attack_id } }] }
            default { [] }
        },
        switch workspace.nsp_kv.alert_type != null and workspace.nsp_kv.alert_type != "" {
            true { [{ key: "trellix.nsp.alert.type", value: { string_value: workspace.nsp_kv.alert_type } }] }
            default { [] }
        },
        switch workspace.nsp_kv.category != null and workspace.nsp_kv.category != "" {
            true { [{ key: "trellix.nsp.alert.category", value: { string_value: workspace.nsp_kv.category } }] }
            default { [] }
        },
        switch workspace.nsp_kv.virus_name != null and workspace.nsp_kv.virus_name != "" {
            true { [{ key: "trellix.nsp.malware.name", value: { string_value: workspace.nsp_kv.virus_name } }] }
            default { [] }
        },
        switch workspace.nsp_kv.file_hash != null and workspace.nsp_kv.file_hash != "" {
            true { [{ key: "file.hash.md5", value: { string_value: workspace.nsp_kv.file_hash } }] }
            default { [] }
        }
    )
}
