            hostname_field: parse_juniper_srx_sd_syslog_kv(sd, "hostname"),
            status:         parse_juniper_srx_sd_syslog_kv(sd, "status"),
            th:             parse_juniper_srx_sd_syslog_kv(sd, "th"),
            state:          parse_juniper_srx_sd_syslog_kv(sd, "state"),
            reason:         parse_juniper_srx_sd_syslog_kv(sd, "reason"),
            message:        parse_juniper_srx_sd_syslog_kv(sd, "message")
        }
