def process parse_juniper_srx_sd_syslog_aamw_dispatch {
    switch workspace.srx_sd_class.msgid {
        "AAMW_ACTION_LOG"              { process parse_juniper_srx_sd_syslog_aamw_action }
        "SRX_AAMW_ACTION_LOG"          { process parse_juniper_srx_sd_syslog_aamw_action }
        "AAMW_MALWARE_EVENT_LOG"       { process parse_juniper_srx_sd_syslog_aamw_malware }
