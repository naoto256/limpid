// ---------------------------------------------------------------------------
// RT_AAMW dispatch (Sky ATP / Advanced Anti-Malware)
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_aamw_dispatch {
    switch workspace.srx_sd_class.msgid {
        "AAMW_ACTION_LOG"              { process parse_juniper_srx_sd_syslog_aamw_action }
        "SRX_AAMW_ACTION_LOG"          { process parse_juniper_srx_sd_syslog_aamw_action }
        "AAMW_MALWARE_EVENT_LOG"       { process parse_juniper_srx_sd_syslog_aamw_malware }
        "AAMW_HOST_INFECTED_EVENT_LOG" { process parse_juniper_srx_sd_syslog_aamw_host }
        default {
            error "parse_juniper_srx_sd_syslog: unsupported RT_AAMW MSGID ${workspace.srx_sd_class.msgid}: ${workspace.juniper_srx_sd_syslog.body}"
        }
    }
}

def process parse_juniper_srx_sd_syslog_aamw_action {
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    let mal = coalesce(parse_juniper_srx_sd_syslog_kv_or_null(sd, "malware-info"), "AAMW action")
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
        4,
        juniper_srx_sd_syslog_status_id(action),
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        juniper_srx_sd_syslog_proto_name(parse_juniper_srx_sd_syslog_kv(sd, "protocol-id")),
        mal, mal, mal,
        ["Sky ATP", "Malware"],
        action,
        parse_juniper_srx_sd_syslog_kv(sd, "policy-name"),
        null, null,
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            file_category:  parse_juniper_srx_sd_syslog_kv(sd, "file-category"),
            verdict_number: parse_juniper_srx_sd_syslog_kv(sd, "verdict-number"),
            http_host:      parse_juniper_srx_sd_syslog_kv(sd, "http-host"),
            hostname_field: parse_juniper_srx_sd_syslog_kv(sd, "hostname"),
            application:    parse_juniper_srx_sd_syslog_kv(sd, "application"),
            session_id:     parse_juniper_srx_sd_syslog_kv(sd, "session-id-32"),
            username:       parse_juniper_srx_sd_syslog_kv_or_null(sd, "username")
        }
    )
}

def process parse_juniper_srx_sd_syslog_aamw_malware {
    let sd = workspace.srx_sd_class.sd
    let mal = coalesce(parse_juniper_srx_sd_syslog_kv_or_null(sd, "malware-info"), "AAMW malware")
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
        4,
        2,
        parse_juniper_srx_sd_syslog_kv(sd, "client-ip"),
        null, null, null,
        null,
        mal, mal, mal,
        ["Sky ATP", "Malware"],
        null,
        null, null, null, null, null,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            tenant_id:      parse_juniper_srx_sd_syslog_kv(sd, "tenant-id"),
            sample_sha256:  parse_juniper_srx_sd_syslog_kv(sd, "sample-sha256"),
            verdict_number: parse_juniper_srx_sd_syslog_kv(sd, "verdict-number"),
            hostname_field: parse_juniper_srx_sd_syslog_kv(sd, "hostname"),
            username:       parse_juniper_srx_sd_syslog_kv_or_null(sd, "username")
        }
    )
}

def process parse_juniper_srx_sd_syslog_aamw_host {
    let sd = workspace.srx_sd_class.sd
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
        5,
        2,
        parse_juniper_srx_sd_syslog_kv(sd, "client-ip"),
