// ---------------------------------------------------------------------------
// RT_UTM dispatch
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_utm_dispatch {
    switch workspace.srx_sd_class.msgid {
        "WEBFILTER_URL_BLOCKED"          { process parse_juniper_srx_sd_syslog_utm_webfilter }
        "WEBFILTER_URL_BLOCKED_LS"       { process parse_juniper_srx_sd_syslog_utm_webfilter }
        "WEBFILTER_URL_PERMITTED"        { process parse_juniper_srx_sd_syslog_utm_webfilter }
        "AV_VIRUS_DETECTED_MT"           { process parse_juniper_srx_sd_syslog_utm_antivirus }
        "AV_VIRUS_DETECTED_MT_LS"        { process parse_juniper_srx_sd_syslog_utm_antivirus }
        "AV_FILE_NOT_SCANNED_DROPPED_MT" { process parse_juniper_srx_sd_syslog_utm_antivirus }
        "AV_HUGE_FILE_DROPPED_MT"        { process parse_juniper_srx_sd_syslog_utm_antivirus }
        "AV_SCANNER_DROP_FILE_MT"        { process parse_juniper_srx_sd_syslog_utm_antivirus }
        "ANTISPAM_SPAM_DETECTED_MT"      { process parse_juniper_srx_sd_syslog_utm_antispam }
        "CONTENT_FILTERING_BLOCKED_MT"   { process parse_juniper_srx_sd_syslog_utm_content }
        default {
            error "parse_juniper_srx_sd_syslog: unsupported RT_UTM MSGID ${workspace.srx_sd_class.msgid}: ${workspace.juniper_srx_sd_syslog.body}"
        }
    }
}

def process parse_juniper_srx_sd_syslog_utm_webfilter {
    let sd = workspace.srx_sd_class.sd
    let permitted = workspace.srx_sd_class.msgid == "WEBFILTER_URL_PERMITTED"
    workspace.limpid = juniper_srx_sd_syslog_http_record(
        switch true { permitted { 1 } default { 2 } },
        switch true { permitted { 1 } default { 3 } },
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "url"),
        parse_juniper_srx_sd_syslog_kv(sd, "category"),
        parse_juniper_srx_sd_syslog_kv(sd, "reason"),
        parse_juniper_srx_sd_syslog_kv(sd, "profile"),
        parse_juniper_srx_sd_syslog_kv_or_null(sd, "username"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_utm_antivirus {
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    let virus = coalesce(parse_juniper_srx_sd_syslog_kv(sd, "virus-name"), workspace.srx_sd_class.msgid)
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
        4,
        juniper_srx_sd_syslog_status_id(action),
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        null,
        virus, virus, virus,
        ["Malware"],
        action,
        null, null, null,
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            filename:           parse_juniper_srx_sd_syslog_kv(sd, "filename"),
            temporary_filename: parse_juniper_srx_sd_syslog_kv(sd, "temporary-filename"),
            url:                parse_juniper_srx_sd_syslog_kv(sd, "url")
        }
    )
}

def process parse_juniper_srx_sd_syslog_utm_antispam {
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
        3,
        juniper_srx_sd_syslog_status_id(action),
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        null, null, null,
        null,
        workspace.srx_sd_class.msgid,
        "Antispam: spam detected",
        "Antispam",
        ["Spam"],
        action,
        parse_juniper_srx_sd_syslog_kv(sd, "profile-name"),
        null, null,
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            reason:   parse_juniper_srx_sd_syslog_kv(sd, "reason"),
            username: parse_juniper_srx_sd_syslog_kv_or_null(sd, "username")
        }
    )
}

def process parse_juniper_srx_sd_syslog_utm_content {
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    workspace.limpid = juniper_srx_sd_syslog_finding_record(
