// Summary:     Juniper SRX sd-syslog (RFC 5424 + [junos@ SD block]) → LSIS by
//              daemon / MSGID.
// Reads:       workspace.juniper_srx_sd_syslog.* (bridge — see Bridges below)
//                .body (required, String) — the full RFC 5424 wire INCLUDING the leading `<PRI>1`
//                .hostname (optional, String) — collector-side override (parser prefers the wire's HOSTNAME field via classify)
// Writes:      workspace.lsis.parsed.* — RT_FLOW / APPTRACK → 4001, RT_IDP / RT_IDS /
//              RT_UTM (AV, antispam, content-filter) / RT_AAMW / RT_SECINTEL →
//              2004, RT_UTM WEBFILTER_URL_* → 4002. juniper_srx_sd_syslog_to_otlp
//              writes source-owned OTLP Resource, Body, and attributes.
// Category:    Network firewall / IPS
// Test corpus: public (elastic/integrations juniper_srx fixtures — 88 events
//              across RT_FLOW / APPTRACK / RT_IDP / RT_IDS / RT_UTM / RT_AAMW /
//              RT_SECINTEL)
//
// Vendor notes — Juniper Networks SRX series (and vSRX) — Junos OS'
//           security log subsystem in `set security log format
//           sd-syslog` mode. Covers the daemons that emit a
//           `[junos@<EID> ...]` structured-data block: RT_FLOW,
//           RT_IDP, RT_IDS (Screen), RT_UTM, RT_AAMW (Sky ATP /
//           Advanced Anti-Malware), RT_SECINTEL.
//
// Wire —     RFC 5424 + Junos structured-data block:
//             <PRI>1 <ts> <host> RT_<DAEMON> - <MSGID> [junos@<EID> key="val" ...]
//           Every daemon shares this outer shape; the SD KV
//           contents differ per MSGID. Field order inside SD is
//           NOT stable across Junos versions, so this parser
//           extracts every field by name independently.
// Bridges —  SRX appliances emit syslog (UDP/514 or TCP/514). The
//           bridge passes the raw wire — parse_syslog is not used
//           because limpid's syslog.parse does not expose the
//           structured-data block, and the SRX session metadata
//           lives entirely in SD. Two typical bridges:
//
//           - syslog (UDP/TCP):
//                 { workspace.juniper_srx_sd_syslog = { body: ingress, hostname: source.ip } } | parse_juniper_srx_sd_syslog | compose_ocsf | ocsf_to_egress
//
//           - tail of a forwarded text file:
//                 { workspace.juniper_srx_sd_syslog = { body: ingress, hostname: hostname() } } | parse_juniper_srx_sd_syslog | compose_ocsf | ocsf_to_egress
//
// Per-daemon dispatch (LSIS class depends on the daemon / MSGID):
//             RT_FLOW (incl. APPTRACK_*)                                            → 4001 Network Activity
//             RT_IDP (IDP_ATTACK_LOG_EVENT, IDP_APPDDOS_*)                          → 2004 Detection Finding
//             RT_IDS (RT_SCREEN_*)                                                  → 2004 Detection Finding
//             RT_UTM AV_*, ANTISPAM_*, CONTENT_FILTERING_*                          → 2004 Detection Finding
//             RT_UTM WEBFILTER_URL_BLOCKED / _PERMITTED                             → 4002 HTTP Activity
//             RT_AAMW (AAMW_*_LOG, SRX_AAMW_ACTION_LOG)                             → 2004 Detection Finding
//             RT_SECINTEL (SECINTEL_ACTION_LOG)                                     → 2004 Detection Finding
//
//           `_LS` (Logical Systems) variants of any MSGID share
//           the SD shape with their non-`_LS` counterpart and
//           route through the same leaf.
//
// Coverage notes — sd-syslog mode only. For unstructured `syslog`
// mode (default Junos format with no SD block, e.g. RT_IDP /
// IDP_ATTACK_LOG_EVENT in plain text) see
// `parse_juniper_srx_syslog.limpid`.

// ---------------------------------------------------------------------------
// Shared helpers
// ---------------------------------------------------------------------------

// Map Junos protocol-id (IANA number as string) to OCSF protocol_name.
def function juniper_srx_sd_syslog_proto_name(p) {
    switch p {
        "1"   { "ICMP" }
        "6"   { "TCP" }
        "17"  { "UDP" }
        "47"  { "GRE" }
        "50"  { "ESP" }
        "51"  { "AH" }
        "58"  { "ICMPv6" }
        default { p }
    }
}

// Map Junos protocol-name (TCP/UDP/ICMP/...) to OCSF protocol_num
// (IANA). Inverse of the above for daemons that emit protocol-name
// instead of protocol-id (RT_IDP).
include "../functions/proto_num.limpid"

// Map the textual Junos IDP threat-severity to OTel SeverityNumber.
def function juniper_srx_sd_syslog_severity_number(s) {
    switch s {
        "INFO"      { 9 }
        "LOW"       { 13 }
        "MEDIUM"    { 17 }
        "HIGH"      { 19 }
        "CRITICAL"  { 21 }
        "UNDEFINED" { null }
        null        { null }
        default     { null }
    }
}

// Map the exact RT_SECINTEL numeric severity lexeme to OTel SeverityNumber.
def function juniper_srx_sd_syslog_secintel_severity_number(s) {
    switch s {
        "0"  { null }
        "1"  { 13 }
        "2"  { 13 }
        "3"  { 13 }
        "4"  { 17 }
        "5"  { 17 }
        "6"  { 17 }
        "7"  { 19 }
        "8"  { 19 }
        "9"  { 19 }
        "10" { 21 }
        null    { null }
        default { null }
    }
}

// Map Junos action to OCSF status_id.
//   DROP / BLOCK / DENY / REJECT / drop / CLOSE → 2 Failure (blocked)
//   PERMIT / ALLOW / permit / accept              → 1 Success (passed)
//   anything else (NONE / IGNORE / log-only)      → 99 Other
def function juniper_srx_sd_syslog_status_id(action) {
    switch action {
        "DROP"   { 2 }
        "BLOCK"  { 2 }
        "DENY"   { 2 }
        "REJECT" { 2 }
        "drop"   { 2 }
        "block"  { 2 }
        "deny"   { 2 }
        "CLOSE"  { 2 }
        "PERMIT" { 1 }
        "ALLOW"  { 1 }
        "permit" { 1 }
        "accept" { 1 }
        default  { 99 }
    }
}

// Extract one SD field by name. SD KV order is NOT stable across
// Junos versions / MSGIDs, so each field is captured independently.
def function parse_juniper_srx_sd_syslog_kv(sd, name) {
    let m = regex_parse(sd, "${name}=\"(?P<v>[^\"]*)\"")
    switch true {
        m == null { null }
        default   { m.v }
    }
}

// Convenience: lookup with empty-string / "N/A" normalisation
// (Junos commonly emits `key="N/A"` for "no value").
def function parse_juniper_srx_sd_syslog_kv_or_null(sd, name) {
    let v = parse_juniper_srx_sd_syslog_kv(sd, name)
    switch true {
        v == null  { null }
        v == "N/A" { null }
        v == ""    { null }
        default    { v }
    }
}

// `to_int` that tolerates null / empty (returns null instead of erroring).
def function juniper_srx_sd_syslog_int_opt(s) {
    switch true {
        s == null  { null }
        s == ""    { null }
        s == "N/A" { null }
        default    { to_int(s) }
    }
}

// ---------------------------------------------------------------------------
// Record builders (per OCSF class)
// ---------------------------------------------------------------------------

// 4001 Network Activity (RT_FLOW / APPTRACK).
def function juniper_srx_sd_syslog_network_record(activity_id, status_id, src_ip, src_port_str, dst_ip, dst_port_str, proto_str, policy, src_zone, dst_zone, session_id, app, bytes_in_str, bytes_out_str, packets_in_str, packets_out_str, reason, msgid, host, time_ns) {
    {
        class_uid:    4001,
        category_uid: 4,
        activity_id:  activity_id,
        status_id:    status_id,
        time:         time_ns,
        src_endpoint: {
            ip:   src_ip,
            port: juniper_srx_sd_syslog_int_opt(src_port_str),
            zone: src_zone
        },
        dst_endpoint: {
            ip:   dst_ip,
            port: juniper_srx_sd_syslog_int_opt(dst_port_str),
            zone: dst_zone
        },
        connection_info: {
            protocol_num:  juniper_srx_sd_syslog_int_opt(proto_str),
            protocol_name: juniper_srx_sd_syslog_proto_name(proto_str),
            session: {
                uid: session_id
            }
        },
        traffic: {
            bytes_in:    juniper_srx_sd_syslog_int_opt(bytes_in_str),
            bytes_out:   juniper_srx_sd_syslog_int_opt(bytes_out_str),
            packets_in:  juniper_srx_sd_syslog_int_opt(packets_in_str),
            packets_out: juniper_srx_sd_syslog_int_opt(packets_out_str)
        },
        app_name: app,
        device: {
            hostname: host
        },
        message: reason,
        unmapped: {
            policy_name: policy,
            msgid:       msgid
        },
        metadata: {
            product: {
                vendor_name: "Juniper Networks",
                name:        "Junos OS (SRX)"
            },
            version: "1.3.0"
        }
    }
}

// 2004 Detection Finding (RT_IDP / RT_IDS / RT_UTM AV/Spam/Content /
// RT_AAMW / RT_SECINTEL). Common skeleton.
def function juniper_srx_sd_syslog_finding_record(severity_number, severity, status_id, src_ip, src_port_str, dst_ip, dst_port_str, proto_name, sig_id, sig_name, technique_name, finding_types, action, policy, rule, rulebase, src_zone, dst_zone, msgid, host, time_ns, extra_unmapped) {
    {
        class_uid:       2004,
        category_uid:    2,
        activity_id:     1,
        severity_number: severity_number,
        severity:        severity,
        status_id:       status_id,
        time:            time_ns,
        finding_info: {
            uid:   sig_id,
            title: sig_name,
            types: finding_types,
            analytic: {
                name: rule,
                uid:  sig_id
            }
        },
        attacks: [{
            technique: {
                name: technique_name,
                uid:  sig_id
            }
        }],
        src_endpoint: {
            ip:   src_ip,
            port: juniper_srx_sd_syslog_int_opt(src_port_str),
            zone: src_zone
        },
        dst_endpoint: {
            ip:   dst_ip,
            port: juniper_srx_sd_syslog_int_opt(dst_port_str),
            zone: dst_zone
        },
        connection_info: {
            protocol_name: proto_name,
            protocol_num:  proto_num(proto_name)
        },
        device: {
            hostname: host
        },
        unmapped: {
            msgid:         msgid,
            action:        action,
            policy_name:   policy,
            rule_name:     rule,
            rulebase_name: rulebase,
            extra:         extra_unmapped
        },
        metadata: {
            product: {
                vendor_name: "Juniper Networks",
                name:        "Junos OS (SRX)"
            },
            version: "1.3.0"
        }
    }
}

// 4002 HTTP Activity (RT_UTM WEBFILTER_URL_BLOCKED / _PERMITTED).
def function juniper_srx_sd_syslog_http_record(status_id, src_ip, src_port_str, dst_ip, dst_port_str, url, category, reason, profile, username, msgid, host, time_ns) {
    {
        class_uid:    4002,
        category_uid: 4,
        activity_id:  3,
        status_id:    status_id,
        time:         time_ns,
        src_endpoint: {
            ip:   src_ip,
            port: juniper_srx_sd_syslog_int_opt(src_port_str)
        },
        dst_endpoint: {
            ip:   dst_ip,
            port: juniper_srx_sd_syslog_int_opt(dst_port_str)
        },
        actor: {
            user: { name: username }
        },
        http_request: {
            url: { url_string: url }
        },
        device: {
            hostname: host
        },
        unmapped: {
            msgid:    msgid,
            category: category,
            reason:   reason,
            profile:  profile
        },
        metadata: {
            product: {
                vendor_name: "Juniper Networks",
                name:        "Junos OS (SRX UTM)"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Classifier
// ---------------------------------------------------------------------------

def function parse_juniper_srx_sd_syslog_classify(body) {
    // Two SD bracket forms seen across Junos versions / vSRX builds:
    //   - `[junos@<EID> <KV>]`  — traditional, with the IANA-style
    //                              enterprise-id prefix (Junos < ~2023)
    //   - `[<KV>]`              — newer vSRX (~2023+) omits the
    //                              `junos@<EID>` prefix and emits the
    //                              KV directly inside the brackets
    // The `(?:junos@\S+ )?` group makes the prefix optional.
    let header = regex_parse(
        body,
        "^<\\d+>1 (?P<timestamp>\\S+) (?P<host>\\S+) RT_(?P<daemon>[A-Z]+) - (?P<msgid>[A-Z][A-Z0-9_]+) \\[(?:junos@\\S+ )?(?P<sd>.*)\\]\\s*$"
    )
    switch true {
        header == null { null }
        default        { header }
    }
}

// ---------------------------------------------------------------------------
// Main process — dispatch by daemon
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_normalize_time {
    workspace.juniper_srx_sd_syslog.time = switch workspace.srx_sd_class.timestamp {
        "-"     { null }
        default { to_int(parse_datetime_rfc3339(workspace.srx_sd_class.timestamp)) }
    }
}

def process parse_juniper_srx_sd_syslog {
    // @requires: workspace.juniper_srx_sd_syslog.body      (required, String)
    // @requires: workspace.juniper_srx_sd_syslog.hostname  (optional, String)
    // The RFC 5424 TIMESTAMP in `.body` is the event time.
    workspace.srx_sd_class = parse_juniper_srx_sd_syslog_classify(workspace.juniper_srx_sd_syslog.body)
    switch true {
        workspace.srx_sd_class == null {
            error "parse_juniper_srx_sd_syslog: not a recognised RT_<daemon> sd-syslog line: ${workspace.juniper_srx_sd_syslog.body}"
        }
        workspace.srx_sd_class.daemon == "FLOW" {
            process parse_juniper_srx_sd_syslog_flow_dispatch
        }
        workspace.srx_sd_class.daemon == "IDP" {
            process parse_juniper_srx_sd_syslog_idp_dispatch
        }
        workspace.srx_sd_class.daemon == "IDS" {
            process parse_juniper_srx_sd_syslog_screen_record
        }
        workspace.srx_sd_class.daemon == "UTM" {
            process parse_juniper_srx_sd_syslog_utm_dispatch
        }
        workspace.srx_sd_class.daemon == "AAMW" {
            process parse_juniper_srx_sd_syslog_aamw_dispatch
        }
        workspace.srx_sd_class.daemon == "SECINTEL" {
            process parse_juniper_srx_sd_syslog_secintel_record
        }
        default {
            error "parse_juniper_srx_sd_syslog: unsupported Junos daemon RT_${workspace.srx_sd_class.daemon}: ${workspace.juniper_srx_sd_syslog.body}"
        }
    }
}

// ---------------------------------------------------------------------------
// RT_FLOW dispatch (session + apptrack)
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_flow_dispatch {
    switch workspace.srx_sd_class.msgid {
        "RT_FLOW_SESSION_CREATE"        { process parse_juniper_srx_sd_syslog_flow_create }
        "RT_FLOW_SESSION_CREATE_LS"     { process parse_juniper_srx_sd_syslog_flow_create }
        "RT_FLOW_SESSION_CLOSE"         { process parse_juniper_srx_sd_syslog_flow_close }
        "RT_FLOW_SESSION_DENY"          { process parse_juniper_srx_sd_syslog_flow_deny }
        "RT_FLOW_SESSION_DENY_LS"       { process parse_juniper_srx_sd_syslog_flow_deny }
        "APPTRACK_SESSION_CREATE"       { process parse_juniper_srx_sd_syslog_apptrack_create }
        "APPTRACK_SESSION_CLOSE"        { process parse_juniper_srx_sd_syslog_apptrack_close }
        "APPTRACK_SESSION_CLOSE_LS"     { process parse_juniper_srx_sd_syslog_apptrack_close }
        "APPTRACK_SESSION_VOL_UPDATE"   { process parse_juniper_srx_sd_syslog_apptrack_volume }
        "APPTRACK_SESSION_ROUTE_UPDATE" { process parse_juniper_srx_sd_syslog_apptrack_volume }
        default {
            error "parse_juniper_srx_sd_syslog: unsupported RT_FLOW MSGID ${workspace.srx_sd_class.msgid}: ${workspace.juniper_srx_sd_syslog.body}"
        }
    }
}

def function parse_juniper_srx_sd_syslog_flow_fields(sd) {
    {
        src:        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        src_port:   parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        dst:        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        dst_port:   parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        proto:      parse_juniper_srx_sd_syslog_kv(sd, "protocol-id"),
        policy:     parse_juniper_srx_sd_syslog_kv(sd, "policy-name"),
        src_zone:   parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        dst_zone:   parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
        session_id: parse_juniper_srx_sd_syslog_kv(sd, "session-id-32"),
        app:        parse_juniper_srx_sd_syslog_kv_or_null(sd, "application"),
        reason:     parse_juniper_srx_sd_syslog_kv(sd, "reason"),
        bytes_in:   parse_juniper_srx_sd_syslog_kv(sd, "bytes-from-client"),
        bytes_out:  parse_juniper_srx_sd_syslog_kv(sd, "bytes-from-server"),
        pkts_in:    parse_juniper_srx_sd_syslog_kv(sd, "packets-from-client"),
        pkts_out:   parse_juniper_srx_sd_syslog_kv(sd, "packets-from-server")
    }
}

def process parse_juniper_srx_sd_syslog_flow_create {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        1, 1,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        null, null, null, null,
        null,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_flow_close {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        2, 1,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        workspace.srx_sd_fields.bytes_in, workspace.srx_sd_fields.bytes_out,
        workspace.srx_sd_fields.pkts_in, workspace.srx_sd_fields.pkts_out,
        workspace.srx_sd_fields.reason,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_flow_deny {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        6, 2,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        null, null, null, null,
        workspace.srx_sd_fields.reason,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_apptrack_create {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        1, 1,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        null, null, null, null,
        null,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_apptrack_close {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        2, 1,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        workspace.srx_sd_fields.bytes_in, workspace.srx_sd_fields.bytes_out,
        workspace.srx_sd_fields.pkts_in, workspace.srx_sd_fields.pkts_out,
        workspace.srx_sd_fields.reason,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

def process parse_juniper_srx_sd_syslog_apptrack_volume {
    process parse_juniper_srx_sd_syslog_normalize_time
    workspace.srx_sd_fields = parse_juniper_srx_sd_syslog_flow_fields(workspace.srx_sd_class.sd)
    workspace.lsis.parsed = juniper_srx_sd_syslog_network_record(
        99, 1,
        workspace.srx_sd_fields.src, workspace.srx_sd_fields.src_port,
        workspace.srx_sd_fields.dst, workspace.srx_sd_fields.dst_port,
        workspace.srx_sd_fields.proto,
        workspace.srx_sd_fields.policy,
        workspace.srx_sd_fields.src_zone, workspace.srx_sd_fields.dst_zone,
        workspace.srx_sd_fields.session_id, workspace.srx_sd_fields.app,
        workspace.srx_sd_fields.bytes_in, workspace.srx_sd_fields.bytes_out,
        workspace.srx_sd_fields.pkts_in, workspace.srx_sd_fields.pkts_out,
        null,
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time
    )
}

// ---------------------------------------------------------------------------
// RT_IDP dispatch
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_idp_dispatch {
    switch workspace.srx_sd_class.msgid {
        "IDP_ATTACK_LOG_EVENT"            { process parse_juniper_srx_sd_syslog_idp_attack }
        "IDP_APPDDOS_APP_ATTACK_EVENT"    { process parse_juniper_srx_sd_syslog_idp_appddos }
        "IDP_APPDDOS_APP_ATTACK_EVENT_LS" { process parse_juniper_srx_sd_syslog_idp_appddos }
        "IDP_APPDDOS_APP_STATE_EVENT"     { process parse_juniper_srx_sd_syslog_idp_appddos }
        default {
            error "parse_juniper_srx_sd_syslog: unsupported RT_IDP MSGID ${workspace.srx_sd_class.msgid}: ${workspace.juniper_srx_sd_syslog.body}"
        }
    }
}

def process parse_juniper_srx_sd_syslog_normalize_idp_severity {
    let severity = parse_juniper_srx_sd_syslog_kv_or_null(workspace.srx_sd_class.sd, "threat-severity")
    let severity_number = juniper_srx_sd_syslog_severity_number(severity)
    switch true {
        severity != null and severity != "UNDEFINED" and severity_number == null {
            error "parse_juniper_srx_sd_syslog: invalid IDP threat severity ${severity}"
        }
        default {
            workspace.srx_sd_severity = {
                number: severity_number,
                text:   severity
            }
        }
    }
}

def process parse_juniper_srx_sd_syslog_idp_attack {
    process parse_juniper_srx_sd_syslog_normalize_time
    process parse_juniper_srx_sd_syslog_normalize_idp_severity
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    workspace.lsis.parsed = juniper_srx_sd_syslog_finding_record(
        workspace.srx_sd_severity.number,
        workspace.srx_sd_severity.text,
        juniper_srx_sd_syslog_status_id(action),
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "protocol-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "attack-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "attack-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "attack-name"),
        ["Network IDS"],
        action,
        parse_juniper_srx_sd_syslog_kv(sd, "policy-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "rule-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "rulebase-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            application_name: parse_juniper_srx_sd_syslog_kv(sd, "application-name"),
            service_name:     parse_juniper_srx_sd_syslog_kv(sd, "service-name")
        }
    )
}

def process parse_juniper_srx_sd_syslog_idp_appddos {
    process parse_juniper_srx_sd_syslog_normalize_time
    process parse_juniper_srx_sd_syslog_normalize_idp_severity
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    let title = coalesce(parse_juniper_srx_sd_syslog_kv(sd, "application-name"), "IDP AppDDoS")
