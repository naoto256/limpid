// ---------------------------------------------------------------------------
// RT_SECINTEL (threat-feed action)
// ---------------------------------------------------------------------------

def process parse_juniper_srx_sd_syslog_normalize_secintel_severity {
    let severity = parse_juniper_srx_sd_syslog_kv_or_null(workspace.srx_sd_class.sd, "threat-severity")
    let severity_number = juniper_srx_sd_syslog_secintel_severity_number(severity)
    switch true {
        severity != null and severity != "0" and severity_number == null {
            error "parse_juniper_srx_sd_syslog: invalid SecIntel threat severity ${severity}"
        }
        default {
            workspace.srx_sd_secintel_severity = {
                number: severity_number,
                raw:    severity
            }
        }
    }
}

def process parse_juniper_srx_sd_syslog_secintel_record {
    process parse_juniper_srx_sd_syslog_normalize_time
    process parse_juniper_srx_sd_syslog_normalize_secintel_severity
    let sd = workspace.srx_sd_class.sd
    let action = parse_juniper_srx_sd_syslog_kv(sd, "action")
    let title = coalesce(parse_juniper_srx_sd_syslog_kv_or_null(sd, "feed-name"), "SecIntel")
    workspace.lsis.parsed = juniper_srx_sd_syslog_finding_record(
        workspace.srx_sd_secintel_severity.number,
        null,
        juniper_srx_sd_syslog_status_id(action),
        parse_juniper_srx_sd_syslog_kv(sd, "source-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-port"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-address"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-port"),
        juniper_srx_sd_syslog_proto_name(parse_juniper_srx_sd_syslog_kv(sd, "protocol-id")),
        title, title, title,
        ["Threat Intelligence"],
        action,
        parse_juniper_srx_sd_syslog_kv(sd, "policy-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "profile-name"),
        null,
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
        workspace.srx_sd_class.msgid,
        coalesce(workspace.srx_sd_class.host, workspace.juniper_srx_sd_syslog.hostname),
        workspace.juniper_srx_sd_syslog.time,
        {
            category:        parse_juniper_srx_sd_syslog_kv(sd, "category"),
            sub_category:    parse_juniper_srx_sd_syslog_kv(sd, "sub-category"),
            action_detail:   parse_juniper_srx_sd_syslog_kv(sd, "action-detail"),
            http_host:       parse_juniper_srx_sd_syslog_kv(sd, "http-host"),
            session_id:      parse_juniper_srx_sd_syslog_kv(sd, "session-id-32"),
            username:        parse_juniper_srx_sd_syslog_kv_or_null(sd, "username"),
            threat_severity: workspace.srx_sd_secintel_severity.raw
        }
    )
}

def function juniper_srx_sd_syslog_otlp_event_kind(class_uid) {
    switch class_uid {
        2004    { "alert" }
        default { "event" }
    }
}

def function juniper_srx_sd_syslog_otlp_event_category(class_uid) {
    switch class_uid {
        2004    { "intrusion_detection" }
        4002    { "web" }
        default { "network" }
    }
}

def function juniper_srx_sd_syslog_otlp_event_type(class_uid) {
    switch class_uid {
        2004    { "indicator" }
        4002    { "access" }
        default { "connection" }
    }
}

def function juniper_srx_sd_syslog_otlp_event_outcome(status_id) {
    switch status_id {
        1       { "success" }
        2       { "failure" }
        default { null }
    }
}

def process juniper_srx_sd_syslog_to_otlp {
    workspace.lsis.shed.otlp.resource.attributes = concat(
        [{ key: "observer.vendor", value: { string_value: "Juniper Networks" } }],
        [{ key: "observer.product", value: { string_value: "Junos OS (SRX)" } }],
        [{ key: "observer.type", value: { string_value: "firewall" } }],
        switch workspace.srx_sd_class.host != null {
            true { [{ key: "host.name", value: { string_value: workspace.srx_sd_class.host } }] }
            default { [] }
        },
        switch workspace.srx_sd_class.daemon != null {
            true { [{ key: "service.name", value: { string_value: "RT_${workspace.srx_sd_class.daemon}" } }] }
            default { [] }
        },
        [{ key: "telemetry.sdk.name", value: { string_value: "limpid" } }],
        [{ key: "telemetry.sdk.version", value: { string_value: version() } }]
    )
    workspace.lsis.shed.otlp.log_record.body = { string_value: workspace.juniper_srx_sd_syslog.body }
    workspace.lsis.shed.otlp.log_record.attributes = concat(
        [{ key: "event.kind", value: { string_value: juniper_srx_sd_syslog_otlp_event_kind(workspace.lsis.parsed.class_uid) } }],
        [{ key: "event.category", value: { array_value: { values: [{ string_value: juniper_srx_sd_syslog_otlp_event_category(workspace.lsis.parsed.class_uid) }] } } }],
        [{ key: "event.type", value: { array_value: { values: [{ string_value: juniper_srx_sd_syslog_otlp_event_type(workspace.lsis.parsed.class_uid) }] } } }],
        switch workspace.srx_sd_class.msgid != null {
            true { [{ key: "event.code", value: { string_value: workspace.srx_sd_class.msgid } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.action != null {
            true { [{ key: "event.action", value: { string_value: workspace.lsis.parsed.unmapped.action } }] }
            default { [] }
        },
        switch juniper_srx_sd_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) != null {
            true { [{ key: "event.outcome", value: { string_value: juniper_srx_sd_syslog_otlp_event_outcome(workspace.lsis.parsed.status_id) } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.message != null {
            true { [{ key: "message", value: { string_value: workspace.lsis.parsed.message } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.actor.user.name != null {
            true { [{ key: "user.name", value: { string_value: workspace.lsis.parsed.actor.user.name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.ip != null {
            true { [{ key: "source.ip", value: { string_value: workspace.lsis.parsed.src_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.port != null {
            true { [{ key: "source.port", value: { int_value: workspace.lsis.parsed.src_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.src_endpoint.zone != null {
            true { [{ key: "source.zone", value: { string_value: workspace.lsis.parsed.src_endpoint.zone } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.ip != null {
            true { [{ key: "destination.ip", value: { string_value: workspace.lsis.parsed.dst_endpoint.ip } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.port != null {
            true { [{ key: "destination.port", value: { int_value: workspace.lsis.parsed.dst_endpoint.port } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.dst_endpoint.zone != null {
            true { [{ key: "destination.zone", value: { string_value: workspace.lsis.parsed.dst_endpoint.zone } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_name != null {
            true { [{ key: "network.transport", value: { string_value: workspace.lsis.parsed.connection_info.protocol_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.protocol_num != null {
            true { [{ key: "network.iana_number", value: { int_value: workspace.lsis.parsed.connection_info.protocol_num } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.connection_info.session.uid != null {
            true { [{ key: "juniper.session.id", value: { string_value: workspace.lsis.parsed.connection_info.session.uid } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.app_name != null {
            true { [{ key: "network.application", value: { string_value: workspace.lsis.parsed.app_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.traffic.bytes_in != null {
            true { [{ key: "source.bytes", value: { int_value: workspace.lsis.parsed.traffic.bytes_in } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.traffic.bytes_out != null {
            true { [{ key: "destination.bytes", value: { int_value: workspace.lsis.parsed.traffic.bytes_out } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.http_request.url.url_string != null {
            true { [{ key: "url.full", value: { string_value: workspace.lsis.parsed.http_request.url.url_string } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.title != null {
            true { [{ key: "rule.name", value: { string_value: workspace.lsis.parsed.finding_info.title } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.uid != null {
            true { [{ key: "rule.id", value: { string_value: workspace.lsis.parsed.finding_info.uid } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.policy_name != null {
            true { [{ key: "juniper.policy.name", value: { string_value: workspace.lsis.parsed.unmapped.policy_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.rule_name != null {
            true { [{ key: "juniper.rule.name", value: { string_value: workspace.lsis.parsed.unmapped.rule_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.unmapped.extra.threat_severity != null {
            true { [{ key: "juniper.secintel.severity", value: { string_value: workspace.lsis.parsed.unmapped.extra.threat_severity } }] }
            default { [] }
        }
    )
}
