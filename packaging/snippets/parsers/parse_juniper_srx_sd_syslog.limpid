        parse_juniper_srx_sd_syslog_kv(sd, "rulebase-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "source-zone-name"),
        parse_juniper_srx_sd_syslog_kv(sd, "destination-zone-name"),
