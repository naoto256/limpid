// BIND DNS query log parser (vocabulary)
//
// Vendor:   ISC BIND 9 (Internet Systems Consortium) — the dominant
//           authoritative + recursive DNS server on Linux / BSD. Not
//           Unbound, not Knot, not PowerDNS, not djbdns; each of those
//           has its own query log format and would land in its own
//           parser file.
// Wire:     BIND `querylog` text format. With `querylog yes;` set in
//           `named.conf` (and a matching `category queries` channel
//           that writes the log somewhere), each query produces one
//           line shaped like:
//             <timestamp> client @<addr> <ip>#<port> [(<view>):]
//             (<qname>): query: <qname> <class> <type> <flags>[ (<server-ip>)]
//           The `@<addr>` is BIND's internal client-id pointer; ignored
//           by this parser. The optional `(<view>)` marker appears when
//           the server has multiple `view` clauses configured.
// Intake:   workspace.bind.body       (required, String) — the query log line
//           workspace.bind.pid        (optional, String) — named pid
//           workspace.bind.hostname   (optional, String) — DNS server hostname
//           workspace.bind.time       (optional, Int)    — epoch nanoseconds of arrival
// Upstream: transport-agnostic. The BIND timestamp inside the body
//           carries millisecond precision in a BIND-specific format
//           (`30-Apr-2026 01:23:45.123`); the OCSF `time` field is
//           populated from the upstream transport time when available
//           (more accurate for SIEM correlation than the BIND
//           timestamp, which is local-TZ-by-default). Two typical
//           bridges:
//
//           - file tail (most common — limpid runs on the DNS server):
//                 { workspace.bind = { body: ingress, pid: null, hostname: hostname(), time: to_int(received_at) } } | parse_bind | compose_ocsf
//
//           - syslog transport (named logs via syslog instead of file):
//                 process parse_syslog | {
//                     workspace.bind = {
//                         body:     workspace.syslog.msg,
//                         pid:      workspace.syslog.procid,
//                         hostname: workspace.syslog.hostname,
//                         time:     to_int(parse_datetime_rfc3339(workspace.syslog.timestamp))
//                     }
//                 } | parse_bind | compose_ocsf
//
//           - journald transport (named running under systemd):
//                 process parse_journald | {
//                     workspace.bind = {
//                         body:     workspace.journald.MESSAGE,
//                         pid:      coalesce(workspace.journald._PID, workspace.journald.SYSLOG_PID),
//                         hostname: workspace.journald._HOSTNAME,
//                         time:     to_int(workspace.journald.__REALTIME_TIMESTAMP) * 1000
//                     }
//                 } | parse_bind | compose_ocsf
//
// Output:   OCSF DNS Activity (class_uid 4003) records on
//           `workspace.lsis`.
//
// Sample BIND querylog lines (what `workspace.bind.body` carries):
//
//   IPv4 client, A record, recursion desired + EDNS:
//   30-Apr-2026 01:23:45.123 client @0x7fef10003330 192.0.2.10#54321 (example.com): query: example.com IN A +E(0) (1.2.3.4)
//
//   IPv6 client, AAAA record, with view name:
//   30-Apr-2026 01:23:45.124 client @0x7fef10003330 2001:db8::10#56789 (internal): example.com IN AAAA +ED (1.2.3.4)
//   30-Apr-2026 01:23:45.125 client @0x7fef10003330 2001:db8::10#56789 (internal): query: example.com IN AAAA +ED (1.2.3.4)
//
//   Reverse lookup (PTR):
//   30-Apr-2026 01:23:45.126 client @0x7fef10003330 192.0.2.10#54322 (10.2.0.192.in-addr.arpa): query: 10.2.0.192.in-addr.arpa IN PTR + (1.2.3.4)
//
// Coverage scope: this snippet handles BIND's `category queries`
// channel — the per-query line emitted by `querylog yes;`. Other BIND
// log categories (`network`, `security`, `update`, `notify`, …) emit
// different shapes; each would need its own parser. Lines that do not
// match the query shape (e.g. `lame-servers`, `network unreachable`)
// route to `error_log` per the loud-fail-fast policy.

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

// Build the OCSF DNS Activity (4003) record skeleton. Activity is
// hard-coded to 1 (Query) — BIND `querylog` emits one line per inbound
// query; response logging is a separate channel with a different
// shape that this parser does not handle.
def function bind_dns_record(client_ip, client_port_str, qname, qclass, qtype, server_ip, pid_str, host, time_ns) {
    {
        class_uid:    4003,
        category_uid: 4,
        activity_id:  1,
        severity_id:  1,
        time:         time_ns,
        src_endpoint: {
            ip:   client_ip,
            port: to_int(client_port_str)
        },
        dst_endpoint: {
            ip: server_ip
        },
        query: {
            hostname: qname,
            class:    qclass,
            type:     qtype
        },
        device: {
            hostname: host
        },
        actor: {
            process: {
                name: "named",
                pid: switch true {
                    pid_str != null { to_int(pid_str) }
                    default         { null }
                }
            }
        },
        metadata: {
            product: {
                vendor_name: "ISC",
                name:        "BIND"
            },
            version: "1.3.0"
        }
    }
}

// ---------------------------------------------------------------------------
// Main parser
// ---------------------------------------------------------------------------

def process parse_bind {
    // @requires: workspace.bind.body       (required, String)
    // @requires: workspace.bind.pid        (optional, String)
    // @requires: workspace.bind.hostname   (optional, String)
    // @requires: workspace.bind.time       (optional, Int — epoch ns)
    workspace.bind_query = regex_parse(
        workspace.bind.body,
        "^\\S+ \\S+ client (?:@\\S+ )?(?P<client_ip>[0-9A-Fa-f:.]+)#(?P<client_port>\\d+)(?: \\(\\S+\\):)? (?:query: )?(?P<qname>\\S+) (?P<qclass>\\S+) (?P<qtype>\\S+)(?: (?P<flags>\\S+))?(?: \\((?P<server_ip>[0-9A-Fa-f:.]+)\\))?\\s*$"
    )
    switch true {
        workspace.bind_query == null {
            error "parse_bind: not a recognised BIND querylog line: ${workspace.bind.body}"
        }
        default { process parse_bind_query_record }
    }
}

def process parse_bind_query_record {
    workspace.lsis = bind_dns_record(
        workspace.bind_query.client_ip,
        workspace.bind_query.client_port,
        workspace.bind_query.qname,
        workspace.bind_query.qclass,
        workspace.bind_query.qtype,
        workspace.bind_query.server_ip,
        workspace.bind.pid,
        workspace.bind.hostname,
        workspace.bind.time
    )
}
