            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.title != null {
            true { [{ key: "rule.name", value: { string_value: workspace.lsis.parsed.finding_info.title } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.finding_info.uid != null {
            true { [{ key: "palo_alto.finding.id", value: { string_value: workspace.lsis.parsed.finding_info.uid } }] }
            default { [] }
        },
        switch workspace.cef.severity != null {
            true { [{ key: "palo_alto.cef.severity", value: { int_value: to_int(workspace.cef.severity) } }] }
            default { [] }
        }
    )
}
