            default { [] }
        },
        switch workspace.lsis.parsed.app_name != null {
            true { [{ key: "network.application", value: { string_value: workspace.lsis.parsed.app_name } }] }
            default { [] }
        },
        switch workspace.lsis.parsed.http_request.url.url_string != null {
