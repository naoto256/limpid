// Function: parse_datetime_rfc3164(text) → Timestamp
//
// Wire:     RFC 3164 BSD syslog timestamp — `Apr 30 01:23:45`
// Output:   Value::Timestamp (UTC-normalised)
//
// Counterpart to the built-in `parse_datetime_rfc3339` primitive,
// shipped as LPL rather than Rust because RFC 3164 timestamps
// require policy decisions that should be operator-editable:
//
//   1. The wire carries no year. We assume current year, with a
//      future-clamp: if the parsed datetime is more than 24 hours
//      ahead of `timestamp()`, it actually refers to the previous
//      year (year-end rollover). This is what rsyslog / syslog-ng /
//      Vector / Fluent Bit all converge on.
//
//   2. The wire carries no timezone. We assume UTC. Operators on
//      non-UTC senders should fork this snippet and substitute the
//      `"UTC"` argument with their own offset / "local". The
//      timezone is unrecoverable from the wire; whichever choice is
//      made is an assumption.
//
// For modern senders (RFC 5424 syslog, OTLP, OCSF, AWS CloudTrail,
// most cloud audit logs) use the built-in `parse_datetime_rfc3339`
// directly — it accepts the `Z` literal and any numeric offset
// transparently.

def function parse_datetime_rfc3164(text) {
    let now_ts   = timestamp()
    let now_year = to_int(strftime(now_ts, "%Y", "UTC"))

    let tentative = strptime(
        "${now_year} ${text}",
        "%Y %b %_d %H:%M:%S",
        "UTC"
    )

    // future-clamp: tentative > now + 24h ⇒ wire is from last year
    switch true {
        to_int(tentative) > to_int(now_ts) + 86400000000000 {
            strptime(
                "${now_year - 1} ${text}",
                "%Y %b %_d %H:%M:%S",
                "UTC"
            )
        }
        default { tentative }
    }
}
