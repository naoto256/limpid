// Function: http_method_activity_id(method) → Int
//
// HTTP request method → OCSF 4002 HTTP Activity `activity_id`.
//
// This mapping is OCSF spec standard (4002 class definition,
// vendor-independent): each HTTP method has one canonical
// activity_id, regardless of which parser observed the request.
//
//   CONNECT → 1
//   DELETE  → 2
//   GET     → 3
//   HEAD    → 4
//   OPTIONS → 5
//   POST    → 6
//   PUT     → 7
//   TRACE   → 8
//   anything else → 99 (Other)
//
// PATCH is not in OCSF 1.3.0's enumeration and routes to 99 (the
// next OCSF revision is expected to add it; revisit then).
//
// Method strings are upstream-as-emitted (uppercase by HTTP spec).
// Lowercase / mixed-case method strings (rare, non-compliant) fall
// through to 99.
//
// Used by: parse_suricata, parse_zeek_default (transitively
// inherited by parse_zeek_soc / parse_zeek_full), parse_combined_log
// (Apache / Nginx), and any future HTTP-emitting parser
// (parse_envoy, parse_haproxy, parse_nginx_error, ...).

def function http_method_activity_id(method) {
    switch method {
        "CONNECT" { 1 }
        "DELETE"  { 2 }
        "GET"     { 3 }
        "HEAD"    { 4 }
        "OPTIONS" { 5 }
        "POST"    { 6 }
        "PUT"     { 7 }
        "TRACE"   { 8 }
        default   { 99 }
    }
}
