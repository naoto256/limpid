// Facade: function http_method_activity_id
// Test corpus: unit (OCSF 1.3.0 class 4002 activity_id enumeration)
//
// This mapping is OCSF spec standard (4002 class definition,
// vendor-independent): each HTTP method has one canonical
// activity_id, regardless of which parser observed the request.
//
//   CONNECT → 1
//   DELETE  → 2
//   GET     → 3
//   HEAD    → 4
//   OPTIONS → 5
//   POST    → 6
//   PUT     → 7
//   TRACE   → 8
//   anything else → 99 (Other)
//
// PATCH is not in OCSF 1.3.0's enumeration and routes to 99.
// See https://github.com/ocsf/ocsf-schema/blob/v1.3.0/events/network/http.json
//
// RFC 9110 section 9.1 defines method tokens as case-sensitive; uppercase
// standard method names are a convention, not a rule for every extension.
// This mapper recognizes the uppercase names above. Other tokens,
// including differently cased names, fall through to 99.
// See https://www.rfc-editor.org/rfc/rfc9110#section-9.1

// Function: http_method_activity_id
// Summary: HTTP request method → OCSF 4002 HTTP Activity `activity_id` (spec-standard enumeration, vendor-independent).
// Signature: http_method_activity_id(String) → Int
def function http_method_activity_id(method) {
    switch method {
        "CONNECT" { 1 }
        "DELETE"  { 2 }
        "GET"     { 3 }
        "HEAD"    { 4 }
        "OPTIONS" { 5 }
        "POST"    { 6 }
        "PUT"     { 7 }
        "TRACE"   { 8 }
        default   { 99 }
    }
}
