// /etc/limpid/limpid.conf — main configuration

include "inputs/*.limpid"
include "outputs/*.limpid"
include "processes/*.limpid"
include "pipelines/*.limpid"

// Example opaque-datagram input. Production deployments normally place input
// definitions in /etc/limpid/inputs/*.limpid.
// def input packets {
//     type raw_udp
//     bind "0.0.0.0:5514"
// }

geoip {
    database "/usr/share/GeoIP/GeoLite2-City.mmdb"
}

control {
    socket "/var/run/limpid/control.sock"
}
